@model PaginatedList<CategoryListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Catalog.Categories.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
    ViewData["PageIcon"] = "bi-diagram-3";
    var search = ViewBag.Search as string;
    var isActive = ViewBag.IsActive as bool?;
}

<!-- Header Actions -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex gap-2 align-items-center">
        <span class="text-muted">
            مجموع: <strong>@Model.TotalCount</strong> دسته‌بندی
        </span>
    </div>

    @if (User.HasPermission(Permissions.Categories.Create))
    {
        <a asp-action="Create" class="btn btn-admin-primary">
            <i class="bi bi-plus-lg"></i>
            افزودن دسته‌بندی
        </a>
    }
</div>

<!-- Filters -->
<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control"
                   placeholder="نام یا نامک..." value="@search" />
        </div>

        <div class="col-md-2">
            <label class="form-label small">وضعیت</label>
            <select name="isActive" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isActive == true)">فعال</option>
                <option value="false" selected="@(isActive == false)">غیرفعال</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label small">مرتب‌سازی</label>
            <select name="sortBy" class="form-select">
                <option value="displayOrder" selected="@(ViewBag.SortBy == "displayOrder")">ترتیب نمایش</option>
                <option value="name" selected="@(ViewBag.SortBy == "name")">نام</option>
                <option value="createdAt" selected="@(ViewBag.SortBy == "createdAt")">تاریخ ایجاد</option>
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search"></i> فیلتر
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-inbox"></i></div>
            <h5 class="text-muted">دسته‌بندی یافت نشد</h5>
            @if (User.HasPermission(Permissions.Categories.Create))
            {
                <a asp-action="Create" class="btn btn-admin-primary mt-2">
                    <i class="bi bi-plus-lg"></i> افزودن اولین دسته‌بندی
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">تصویر</th>
                        <th>نام</th>
                        <th>نامک</th>
                        <th>والد</th>
                        <th class="text-center">محصولات</th>
                        <th class="text-center">زیردسته</th>
                        <th class="text-center">ترتیب</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 150px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(cat.ImageUrl))
                                {
                                    <img src="@cat.ImageUrl" alt="@cat.Name"
                                         style="width: 40px; height: 40px; object-fit: cover; border-radius: 6px;" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                         style="width: 40px; height: 40px; border-radius: 6px;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="fw-bold">@cat.Name</span>
                                @if (cat.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark ms-1">ویژه</span>
                                }
                            </td>
                            <td><code class="small">@cat.Slug</code></td>
                            <td class="text-muted small">@(cat.ParentName ?? "—")</td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@cat.ProductCount</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@cat.ChildrenCount</span>
                            </td>
                            <td class="text-center text-muted small">@cat.DisplayOrder</td>
                            <td class="text-center">
                                @if (User.HasPermission(Permissions.Categories.Edit))
                                {
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-active" type="checkbox"
                                               data-id="@cat.Id"
                                        @(cat.IsActive ? "checked" : "") />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge @(cat.IsActive ? "bg-success" : "bg-secondary")">
                                        @(cat.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (User.HasPermission(Permissions.Categories.Edit))
                                    {
                                        <a asp-action="Edit" asp-route-id="@cat.Id"
                                           class="btn btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (User.HasPermission(Permissions.Categories.Delete))
                                    {
                                        <button type="button" class="btn btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                data-id="@cat.Id" data-name="@cat.Name" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-search="@search"
                               asp-route-sortBy="@ViewBag.SortBy">
                                قبلی
                            </a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == 1 || i == Model.TotalPages ||
                                (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageNumber="@i"
                                       asp-route-search="@search"
                                       asp-route-sortBy="@ViewBag.SortBy">
                                        @i
                                    </a>
                                </li>
                            }
                            else if (i == Model.PageNumber - 3 || i == Model.PageNumber + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-search="@search"
                               asp-route-sortBy="@ViewBag.SortBy">
                                بعدی
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />

                <div class="modal-header">
                    <h5 class="modal-title">تایید حذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    آیا از حذف دسته‌بندی
                    <strong id="deleteName" class="text-danger"></strong>
                    مطمئن هستید؟
                    <br />
                    <small class="text-muted">این عمل قابل بازگشت نیست.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle active
        document.querySelectorAll('.toggle-active').forEach(el => {
            el.addEventListener('change', async function() {
                const id = this.dataset.id;
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                try {
                    const response = await fetch('@Url.Action("ToggleActive")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: `id=${id}&__RequestVerificationToken=${token}`
                    });

                    const data = await response.json();
                    if (!data.success) {
                        alert(data.message);
                        this.checked = !this.checked;
                    }
                } catch {
                    alert('خطا در تغییر وضعیت');
                    this.checked = !this.checked;
                }
            });
        });

        // Delete modal
        const deleteModal = document.getElementById('deleteModal');
        deleteModal?.addEventListener('show.bs.modal', function(event) {
            const button = event.relatedTarget;
            document.getElementById('deleteId').value = button.dataset.id;
            document.getElementById('deleteName').textContent = button.dataset.name;
        });
    </script>
}