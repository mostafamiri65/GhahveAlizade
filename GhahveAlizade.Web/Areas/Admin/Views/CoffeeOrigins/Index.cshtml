@model PaginatedList<CoffeeOriginListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Coffee.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "خاستگاه‌های قهوه";
    ViewData["PageIcon"] = "bi-geo-alt";
    var search = ViewBag.Search as string;
    var isActive = ViewBag.IsActive as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <span class="text-muted">مجموع: <strong>@Model.TotalCount</strong> خاستگاه</span>
    @if (User.HasPermission(Permissions.Coffee.ManageOrigins))
    {
        <a asp-action="Create" class="btn btn-admin-primary">
            <i class="bi bi-plus-lg"></i> افزودن خاستگاه
        </a>
    }
</div>

<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control" value="@search" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">وضعیت</label>
            <select name="isActive" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isActive == true)">فعال</option>
                <option value="false" selected="@(isActive == false)">غیرفعال</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search"></i> فیلتر</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-geo-alt"></i></div>
            <h5 class="text-muted">خاستگاهی یافت نشد</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">پرچم</th>
                        <th>نام</th>
                        <th>کد کشور</th>
                        <th class="text-center">مناطق</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 150px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(o.FlagUrl))
                                {
                                    <img src="@o.FlagUrl" alt="@o.Name" style="width: 40px; height: 30px; object-fit: cover;" />
                                }
                                else
                                {

                                    <span>🏳️</span>
                                }
                            </td>
                            <td class="fw-bold">@o.Name</td>
                            <td class="text-muted small">@(o.CountryCode ?? "—")</td>
                            <td class="text-center"><span class="badge bg-secondary">@o.RegionCount</span></td>
                            <td class="text-center">
                                @if (User.HasPermission(Permissions.Coffee.ManageOrigins))
                                {
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-active" type="checkbox" data-id="@o.Id" @(o.IsActive ? "checked" : "") />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge @(o.IsActive ? "bg-success" : "bg-secondary")">@(o.IsActive ? "فعال" : "غیرفعال")</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (User.HasPermission(Permissions.Coffee.ManageOrigins))
                                    {
                                        <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@o.Id" data-name="@o.Name">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header"><h5 class="modal-title">تایید حذف</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">آیا از حذف <strong id="deleteName" class="text-danger"></strong> مطمئن هستید؟</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        document.querySelectorAll('.toggle-active').forEach(el => {
            el.addEventListener('change', async function () {
                const id = this.dataset.id;
                const r = await fetch('@Url.Action("ToggleActive")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: `id=${id}&__RequestVerificationToken=${token}`
                });
                const d = await r.json();
                if (!d.success) { alert(d.message); this.checked = !this.checked; }
            });
        });
        document.getElementById('deleteModal')?.addEventListener('show.bs.modal', function (e) {
            const b = e.relatedTarget;
            document.getElementById('deleteId').value = b.dataset.id;
            document.getElementById('deleteName').textContent = b.dataset.name;
        });
    </script>
}