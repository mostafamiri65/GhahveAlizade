@model CoffeeOriginFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" dir="ltr" />
    </div>
    <div class="col-md-3">
        <label asp-for="CountryCode" class="form-label"></label>
        <input asp-for="CountryCode" class="form-control" dir="ltr" placeholder="IR" maxlength="5" />
    </div>

    <div class="col-md-6">
        <label asp-for="FlagUrl" class="form-label"></label>
        <input asp-for="FlagUrl" class="form-control" dir="ltr" />
    </div>
    <div class="col-md-6">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" dir="ltr" />
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
    </div>

    <div class="col-md-3">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" type="number" class="form-control" />
    </div>
    <div class="col-md-3">
        <div class="form-check form-switch mt-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>

    <!-- Regions -->
    <div class="col-12 mt-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="text-muted border-bottom pb-2 mb-0 flex-grow-1">مناطق</h6>
            <button type="button" class="btn btn-sm btn-admin-primary ms-2" onclick="addRegion()">
                <i class="bi bi-plus-lg"></i> افزودن منطقه
            </button>
        </div>

        <div id="regionsContainer">
            @for (var i = 0; i < Model.Regions.Count; i++)
            {
                var r = Model.Regions[i];
                <div class="card mb-2 region-item">
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small">نام *</label>
                                <input name="Regions[@i].Name" value="@r.Name" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">نامک</label>
                                <input name="Regions[@i].Slug" value="@r.Slug" class="form-control form-control-sm" dir="ltr" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">ارتفاع</label>
                                <input name="Regions[@i].Altitude" value="@r.Altitude" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-1">
                                <label class="form-label small">ترتیب</label>
                                <input name="Regions[@i].DisplayOrder" value="@r.DisplayOrder" type="number" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-1 text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.region-item').remove()">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <div class="col-12">
                                <textarea name="Regions[@i].Description" class="form-control form-control-sm" rows="2" placeholder="توضیحات">@r.Description</textarea>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check">
                                    <input type="checkbox" name="Regions[@i].IsActive" value="true" class="form-check-input" @(r.IsActive ? "checked" : "") />
                                    <label class="form-check-label small">فعال</label>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" name="Regions[@i].Id" value="@r.Id" />
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<template id="regionTemplate">
    <div class="card mb-2 region-item">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small">نام *</label>
                    <input name="Regions[__INDEX__].Name" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">نامک</label>
                    <input name="Regions[__INDEX__].Slug" class="form-control form-control-sm" dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">ارتفاع</label>
                    <input name="Regions[__INDEX__].Altitude" class="form-control form-control-sm" />
                </div>
                <div class="col-md-1">
                    <label class="form-label small">ترتیب</label>
                    <input name="Regions[__INDEX__].DisplayOrder" type="number" class="form-control form-control-sm" value="0" />
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.region-item').remove()">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="col-12">
                    <textarea name="Regions[__INDEX__].Description" class="form-control form-control-sm" rows="2" placeholder="توضیحات"></textarea>
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input type="checkbox" name="Regions[__INDEX__].IsActive" value="true" class="form-check-input" checked />
                        <label class="form-check-label small">فعال</label>
                    </div>
                </div>
            </div>
            <input type="hidden" name="Regions[__INDEX__].Id" value="0" />
        </div>
    </div>
</template>

<script>
    let regionIndex = @Model.Regions.Count;
    function addRegion() {
        const tpl = document.getElementById('regionTemplate').innerHTML;
        document.getElementById('regionsContainer').insertAdjacentHTML('beforeend',
            tpl.replace(/__INDEX__/g, regionIndex++));
    }
</script>