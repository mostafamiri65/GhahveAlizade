@using GhahveAlizade.Web.Areas.Admin.Models.Seo
@model SeoLandingPageFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#slp-main">اطلاعات اصلی</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#slp-filter">فیلتر محصولات</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#slp-seo">سئو</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="slp-main">
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" autofocus />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" dir="ltr" />
            </div>

            <div class="col-12">
                <label asp-for="H1" class="form-label"></label>
                <input asp-for="H1" class="form-control" />
            </div>

            <div class="col-md-8">
                <label asp-for="FeaturedImageUrl" class="form-label"></label>
                <input asp-for="FeaturedImageUrl" class="form-control" dir="ltr" />
            </div>

            <div class="col-12">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" rows="10" class="form-control"></textarea>
            </div>

            <div class="col-12">
                <div class="form-check form-switch">
                    <input asp-for="IsPublished" class="form-check-input" />
                    <label asp-for="IsPublished" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="slp-filter">
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="FilterCriteriaJson" class="form-label"></label>
                <textarea asp-for="FilterCriteriaJson" rows="8" class="form-control" dir="ltr"></textarea>
                <small class="text-muted">
                    نمونه: <code>{"categoryId": 5, "brandId": 2, "minPrice": 100000}</code>
                </small>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="slp-seo">
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="MetaTitle" class="form-label"></label>
                <input asp-for="MetaTitle" class="form-control" maxlength="200" />
            </div>
            <div class="col-12">
                <label asp-for="MetaDescription" class="form-label"></label>
                <textarea asp-for="MetaDescription" rows="2" class="form-control" maxlength="500"></textarea>
            </div>
            <div class="col-12">
                <label asp-for="MetaKeywords" class="form-label"></label>
                <input asp-for="MetaKeywords" class="form-control" maxlength="500" />
            </div>
            <div class="col-md-6">
                <label asp-for="CanonicalUrl" class="form-label"></label>
                <input asp-for="CanonicalUrl" class="form-control" dir="ltr" />
            </div>
            <div class="col-md-6">
                <label asp-for="OgImage" class="form-label"></label>
                <input asp-for="OgImage" class="form-control" dir="ltr" />
            </div>
            <div class="col-12">
                <label asp-for="JsonLdSchema" class="form-label"></label>
                <textarea asp-for="JsonLdSchema" rows="4" class="form-control" dir="ltr"></textarea>
            </div>
        </div>
    </div>
</div>