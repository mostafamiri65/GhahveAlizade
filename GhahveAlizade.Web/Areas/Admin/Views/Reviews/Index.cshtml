@model PaginatedList<ReviewListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Reviews.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "نظرات";
    ViewData["PageIcon"] = "bi-star";
    var search = ViewBag.Search as string;
    var rating = ViewBag.Rating as int?;
    var isApproved = ViewBag.IsApproved as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">مجموع: <strong>@Model.TotalCount</strong> نظر</span>
</div>

<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control" value="@search" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">امتیاز</label>
            <select name="rating" class="form-select">
                <option value="">همه</option>
                @for (var i = 5; i >= 1; i--)
                {
                    <option value="@i" selected="@(rating == i)">@i ستاره</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">وضعیت</label>
            <select name="isApproved" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isApproved == true)">تایید شده</option>
                <option value="false" selected="@(isApproved == false)">در انتظار</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search"></i> فیلتر
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-star"></i></div>
            <h5 class="text-muted">نظری یافت نشد</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>محصول</th>
                        <th>نویسنده</th>
                        <th class="text-center">امتیاز</th>
                        <th>متن</th>
                        <th class="text-center">تاریخ</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 130px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td>
                                <a href="/admin/products/edit/@r.ProductId" target="_blank" class="fw-bold small">
                                    @r.ProductName
                                </a>
                            </td>
                            <td class="small">
                                <div>@(r.CustomerName ?? r.AuthorName ?? "ناشناس")</div>
                                @if (r.IsVerifiedPurchase)
                                {
                                    <span class="badge bg-success small">خرید تایید شده</span>
                                }
                            </td>
                            <td class="text-center">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star@(i <= r.Rating ? "-fill" : "") text-warning small"></i>
                                }
                            </td>
                            <td class="small" style="max-width: 300px;">
                                @if (!string.IsNullOrEmpty(r.Title))
                                {
                                    <div class="fw-bold">@r.Title</div>
                                }
                                <div class="text-muted text-truncate">@r.Content</div>
                                @if (r.ImageCount > 0)
                                {
                                    <i class="bi bi-image text-info"></i>
                                    <span class="small">@r.ImageCount</span>
                                }
                                @if (r.ReplyCount > 0)
                                {
                                    <i class="bi bi-chat-dots text-success"></i>
                                    <span class="small">@r.ReplyCount</span>
                                }
                            </td>
                            <td class="text-center small text-muted">
                                @r.CreatedAtUtc.ToString("yyyy/MM/dd")
                            </td>
                            <td class="text-center">
                                @if (User.HasPermission(Permissions.Reviews.Approve))
                                {
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-approve" type="checkbox"
                                               data-id="@r.Id" @(r.IsApproved ? "checked" : "") />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge @(r.IsApproved ? "bg-success" : "bg-warning text-dark")">
                                        @(r.IsApproved ? "تایید" : "در انتظار")
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detail" asp-route-id="@r.Id"
                                       class="btn btn-outline-info" title="جزئیات">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.HasPermission(Permissions.Reviews.Delete))
                                    {
                                        <form asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('حذف این نظر؟')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @if (Model.HasPrevious)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)">قبلی</a>
                            </li>
                        }
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i">@i</a>
                            </li>
                        }
                        @if (Model.HasNext)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)">بعدی</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        document.querySelectorAll('.toggle-approve').forEach(el => {
            el.addEventListener('change', async function() {
                const id = this.dataset.id;
                const r = await fetch('@Url.Action("Approve")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: `id=${id}&__RequestVerificationToken=${token}`
                });
                const d = await r.json();
                if (!d.success) { alert(d.message); this.checked = !this.checked; }
            });
        });
    </script>
}