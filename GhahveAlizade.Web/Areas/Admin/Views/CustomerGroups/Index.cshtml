@model List<CustomerGroupDto>
@using GhahveAlizade.Application.Features.Customers.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "گروه‌های مشتریان";
    ViewData["PageIcon"] = "bi-people";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">مجموع: <strong>@Model.Count</strong> گروه</span>
    @if (User.HasPermission(Permissions.Customers.ManageGroups))
    {
        <button class="btn btn-admin-primary" data-bs-toggle="modal" data-bs-target="#createModal">
            <i class="bi bi-plus-lg"></i> افزودن گروه
        </button>
    }
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-people"></i></div>
            <h5 class="text-muted">گروهی یافت نشد</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>نام</th>
                        <th>توضیحات</th>
                        <th class="text-center">تخفیف</th>
                        <th class="text-center">لیست قیمت</th>
                        <th class="text-center">ترتیب</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 130px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in Model)
                    {
                        <tr>
                            <td class="fw-bold">@g.Name</td>
                            <td class="small text-muted">@(g.Description ?? "—")</td>
                            <td class="text-center">
                                @if (g.DiscountPercent.HasValue)
                                {
                                    <span class="badge bg-success">@g.DiscountPercent%</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center small">@(g.PriceListName ?? "—")</td>
                            <td class="text-center text-muted small">@g.DisplayOrder</td>
                            <td class="text-center">
                                <span class="badge @(g.IsActive ? "bg-success" : "bg-secondary")">
                                    @(g.IsActive ? "فعال" : "غیرفعال")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (User.HasPermission(Permissions.Customers.ManageGroups))
                                    {
                                        <button type="button" class="btn btn-outline-primary edit-group"
                                                data-id="@g.Id" data-name="@g.Name"
                                                data-description="@g.Description"
                                                data-discount="@g.DiscountPercent"
                                                data-display="@g.DisplayOrder"
                                                data-active="@g.IsActive">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger"
                                                onclick="deleteGroup(@g.Id, '@g.Name')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">افزودن/ویرایش گروه</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="groupId" />
                <div class="mb-2">
                    <label class="form-label">نام *</label>
                    <input id="groupName" class="form-control" />
                </div>
                <div class="mb-2">
                    <label class="form-label">توضیحات</label>
                    <textarea id="groupDescription" rows="2" class="form-control"></textarea>
                </div>
                <div class="mb-2">
                    <label class="form-label">درصد تخفیف</label>
                    <input id="groupDiscount" type="number" step="0.01" class="form-control" dir="ltr" />
                </div>
                <div class="mb-2">
                    <label class="form-label">ترتیب</label>
                    <input id="groupDisplay" type="number" class="form-control" value="0" />
                </div>
                <div class="form-check form-switch">
                    <input type="checkbox" id="groupActive" class="form-check-input" checked />
                    <label class="form-check-label" for="groupActive">فعال</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-admin-primary" onclick="saveGroup()">ذخیره</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const modal = new bootstrap.Modal(document.getElementById('createModal'));

        document.querySelectorAll('.edit-group').forEach(b => {
            b.addEventListener('click', function() {
                document.getElementById('groupId').value = this.dataset.id;
                document.getElementById('groupName').value = this.dataset.name;
                document.getElementById('groupDescription').value = this.dataset.description || '';
                document.getElementById('groupDiscount').value = this.dataset.discount || '';
                document.getElementById('groupDisplay').value = this.dataset.display || 0;
                document.getElementById('groupActive').checked = this.dataset.active === 'true';
                modal.show();
            });
        });

        document.getElementById('createModal')?.addEventListener('show.bs.modal', function() {
            // اگه از دکمه create باز شده، فیلدها رو خالی کن
        });

        async function saveGroup() {
            const id = document.getElementById('groupId').value;
            const name = document.getElementById('groupName').value.trim();
            if (!name) { alert('نام الزامی است'); return; }

            const body = new URLSearchParams();
            if (id) body.append('id', id);
            body.append('name', name);
            body.append('description', document.getElementById('groupDescription').value);
            body.append('discountPercent', document.getElementById('groupDiscount').value);
            body.append('displayOrder', document.getElementById('groupDisplay').value);
            body.append('isActive', document.getElementById('groupActive').checked);
            body.append('__RequestVerificationToken', token);

            const url = id ? '@Url.Action("Update")' : '@Url.Action("Create")';
            const r = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const d = await r.json();
            alert(d.message);
            if (d.success) location.reload();
        }

        async function deleteGroup(id, name) {
            if (!confirm(`حذف گروه "${name}"؟`)) return;
            const body = new URLSearchParams();
            body.append('id', id);
            body.append('__RequestVerificationToken', token);

            const r = await fetch('@Url.Action("Delete")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const d = await r.json();
            alert(d.message);
            if (d.success) location.reload();
        }
    </script>
}