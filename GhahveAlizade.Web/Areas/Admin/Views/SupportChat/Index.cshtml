@using GhahveAlizade.Application.Features.Support.Dtos
@using GhahveAlizade.Domain.Support
@model List<ChatSessionDto>
@{
	var status = ViewBag.Status as ChatSessionStatus?;
	string StatusName(ChatSessionStatus s) => s switch
	{
		ChatSessionStatus.Waiting => "منتظر اپراتور",
		ChatSessionStatus.Active => "فعال",
		ChatSessionStatus.Closed => "بسته", _ => s.ToString()
	};
	string StatusClass(ChatSessionStatus s) => s switch
	{
		ChatSessionStatus.Waiting => "bg-warning text-dark",
		ChatSessionStatus.Active => "bg-success",
		ChatSessionStatus.Closed => "bg-secondary", _ => "bg-secondary"
	};
}

<div class="admin-card mb-3">
	<form method="get" class="row g-2 align-items-end">
		<div class="col-md-4">
			<label class="form-label small">وضعیت</label>
			<select name="status" class="form-select">
				<option value="">همه</option>
				@foreach (ChatSessionStatus s in Enum.GetValues<ChatSessionStatus>())
				{
					<option value="@((int)s)" selected="@(status == s)">@StatusName(s)</option>
				}
			</select>
		</div>
		<div class="col-md-2">
			<button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> فیلتر</button>
		</div>
	</form>
</div>

<div class="admin-card p-0 overflow-hidden">
	@if (Model.Count == 0)
	{
		<div class="text-center py-5">
			<div class="fs-1 text-muted mb-3"><i class="bi bi-chat"></i></div>
			<h5 class="text-muted">گفتگویی یافت نشد</h5>
		</div>
	}
	else
	{
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-light">
					<tr>
						<th>#</th><th>مشتری</th><th class="text-center">وضعیت</th>
						<th class="text-center">خوانده‌نشده</th><th class="text-center">تاریخ</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var s in Model)
					{
						<tr>
							<td>@s.Id</td>
							<td>
								@(s.CustomerName ?? s.GuestName ?? "—")
								@if (!string.IsNullOrEmpty(s.GuestPhoneNumber))
								{
									<div class="small text-muted" dir="ltr">@s.GuestPhoneNumber</div>
								}
							</td>
							<td class="text-center"><span class="badge @StatusClass(s.Status)">@StatusName(s.Status)</span></td>
							<td class="text-center">
								@if (s.UnreadCount > 0)
								{
									<span class="badge bg-danger">@s.UnreadCount</span>
								}
								else
								{
									<span class="text-muted">—</span>
								}
							</td>
							<td class="text-center small text-muted">@s.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
							<td class="text-center">
								<a asp-action="Session" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">
									<i class="bi bi-chat-dots"></i> گفتگو
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</div>
