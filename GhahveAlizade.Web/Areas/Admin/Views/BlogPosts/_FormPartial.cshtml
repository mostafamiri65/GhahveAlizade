@using GhahveAlizade.Web.Areas.Admin.Models.Content
@model BlogPostFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#bp-main">اطلاعات اصلی</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#bp-seo">سئو</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#bp-tags">برچسب‌ها</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="bp-main">
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" autofocus />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CategoryId" class="form-label"></label>
                <select asp-for="CategoryId" class="form-select">
                    <option value="">— بدون دسته —</option>
                    @foreach (var c in Model.FormData.Categories)
                    {
                        <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="Slug" class="form-label"></label>
                <input asp-for="Slug" class="form-control" dir="ltr" placeholder="خودکار از عنوان" />
            </div>
            <div class="col-md-6">
                <label asp-for="AuthorName" class="form-label"></label>
                <input asp-for="AuthorName" class="form-control" />
            </div>

            <div class="col-12">
                <label asp-for="Summary" class="form-label"></label>
                <textarea asp-for="Summary" rows="2" class="form-control" maxlength="2000"></textarea>
                <small class="text-muted">حداکثر 2000 کاراکتر</small>
            </div>

            <div class="col-12">
                <label asp-for="Content" class="form-label"></label>
                <textarea asp-for="Content" rows="15" class="form-control" id="contentEditor"></textarea>
                <span asp-validation-for="Content" class="text-danger small"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="FeaturedImageUrl" class="form-label"></label>
                <input asp-for="FeaturedImageUrl" class="form-control" dir="ltr" />
                <input type="file" name="featuredImageFile" id="featuredImageFile"
                       accept="image/png,image/jpeg,image/webp"
                       data-min-width="1200" data-min-height="800" data-ratio="1.5"
                       class="form-control form-control-sm mt-1" />
                <small class="text-muted d-block">حداقل 1200×800 پیکسل با نسبت 3:2 (افقی)</small>
                <span id="imgDimError" class="text-danger small d-none"></span>
                @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
                {
                    <img src="@Model.FeaturedImageUrl" style="max-height: 100px; margin-top: 0.5rem; border-radius: 6px;" />
                }
            </div>
            <div class="col-md-4">
                <label asp-for="FeaturedImageAlt" class="form-label"></label>
                <input asp-for="FeaturedImageAlt" class="form-control" />
            </div>

            <div class="col-12">
                <div class="d-flex flex-wrap gap-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsPublished" class="form-check-input" />
                        <label asp-for="IsPublished" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="AllowComments" class="form-check-input" />
                        <label asp-for="AllowComments" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="bp-seo">
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="MetaTitle" class="form-label"></label>
                <input asp-for="MetaTitle" class="form-control" maxlength="200" />
                <small class="text-muted">توصیه: 50-60 کاراکتر</small>
            </div>
            <div class="col-12">
                <label asp-for="MetaDescription" class="form-label"></label>
                <textarea asp-for="MetaDescription" rows="2" class="form-control" maxlength="500"></textarea>
                <small class="text-muted">توصیه: 150-160 کاراکتر</small>
            </div>
            <div class="col-12">
                <label asp-for="MetaKeywords" class="form-label"></label>
                <input asp-for="MetaKeywords" class="form-control" maxlength="500" />
            </div>
            <div class="col-md-6">
                <label asp-for="CanonicalUrl" class="form-label"></label>
                <input asp-for="CanonicalUrl" class="form-control" dir="ltr" />
            </div>
            <div class="col-md-6">
                <label asp-for="OgImage" class="form-label"></label>
                <input asp-for="OgImage" class="form-control" dir="ltr" />
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="bp-tags">
        <div class="border rounded p-3" style="max-height: 400px; overflow-y: auto;">
            <div class="row g-2">
                @foreach (var tag in Model.FormData.Tags)
                {
                    <div class="col-md-3 col-6">
                        <div class="form-check">
                            <input type="checkbox" name="TagIds" value="@tag.Id"
                                   class="form-check-input" id="tag_@tag.Id"
                            @(Model.TagIds.Contains(tag.Id) ? "checked" : "") />
                            <label class="form-check-label small" for="tag_@tag.Id">@tag.Name</label>
                        </div>
                    </div>
                }
                @if (!Model.FormData.Tags.Any())
                {
                    <div class="col-12 text-muted small">هنوز برچسبی اضافه نشده است.</div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    // اعتبارسنجی سمت کلاینت: ابعاد حداقل و نسبت تصویر قبل از submit
    document.getElementById('featuredImageFile')?.addEventListener('change', function (e) {
        var f = e.target.files[0], err = document.getElementById('imgDimError');
        if (!f) return;
        var minW = parseInt(this.dataset.minWidth) || 0;
        var minH = parseInt(this.dataset.minHeight) || 0;
        var ratio = parseFloat(this.dataset.ratio) || 0;
        var img = new Image();
        var url = URL.createObjectURL(f);
        img.onload = function () {
            URL.revokeObjectURL(url);
            var ok = img.naturalWidth >= minW && img.naturalHeight >= minH;
            if (ok && ratio) ok = Math.abs(img.naturalWidth / img.naturalHeight - ratio) / ratio <= 0.02;
            err.classList.toggle('d-none', ok);
            if (!ok) {
                err.textContent = 'ابعاد باید حداقل ' + minW + '×' + minH +
                    ' و نسبت ' + ratio + ' باشد. (' + img.naturalWidth + '×' + img.naturalHeight + ')';
                e.target.value = '';
            }
        };
        img.src = url;
    });
</script>