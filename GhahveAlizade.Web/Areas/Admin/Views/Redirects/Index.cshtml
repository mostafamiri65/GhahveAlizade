@model PaginatedList<RedirectListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Seo.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "ریدایرکت‌ها";
    ViewData["PageIcon"] = "bi-arrow-left-right";
    var search = ViewBag.Search as string;
    var isActive = ViewBag.IsActive as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">مجموع: <strong>@Model.TotalCount</strong> ریدایرکت</span>
    @if (User.HasPermission(Permissions.Seo.ManageRedirects))
    {
        <a asp-action="Create" class="btn btn-admin-primary">
            <i class="bi bi-plus-lg"></i> افزودن ریدایرکت
        </a>
    }
</div>

<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control" value="@search" placeholder="مسیر مبدأ یا مقصد..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small">وضعیت</label>
            <select name="isActive" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isActive == true)">فعال</option>
                <option value="false" selected="@(isActive == false)">غیرفعال</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search"></i> فیلتر</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-arrow-left-right"></i></div>
            <h5 class="text-muted">ریدایرکتی یافت نشد</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>مبدأ → مقصد</th>
                        <th class="text-center">نوع</th>
                        <th class="text-center">بازدید</th>
                        <th class="text-center">آخرین بازدید</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 130px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2 small">
                                    <code class="text-danger" dir="ltr">@r.FromPath</code>
                                    <i class="bi bi-arrow-left"></i>
                                    <code class="text-success" dir="ltr">@r.ToPath</code>
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@r.TypeName</span>
                            </td>
                            <td class="text-center fw-bold">@r.HitCount</td>
                            <td class="text-center small text-muted">
                                @if (r.LastHitAtUtc.HasValue)
                                {
                                    @r.LastHitAtUtc.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (User.HasPermission(Permissions.Seo.ManageRedirects))
                                {
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-active" type="checkbox"
                                               data-id="@r.Id" @(r.IsActive ? "checked" : "") />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge @(r.IsActive ? "bg-success" : "bg-secondary")">@(r.IsActive ? "فعال" : "غیرفعال")</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (User.HasPermission(Permissions.Seo.ManageRedirects))
                                    {
                                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                data-id="@r.Id" data-name="@r.FromPath">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header"><h5 class="modal-title">تایید حذف</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">حذف ریدایرکت <strong id="deleteName" class="text-danger" dir="ltr"></strong>؟</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        document.querySelectorAll('.toggle-active').forEach(el => {
            el.addEventListener('change', async function() {
                const id = this.dataset.id;
                const r = await fetch('@Url.Action("ToggleActive")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: `id=${id}&__RequestVerificationToken=${token}`
                });
                const d = await r.json();
                if (!d.success) { alert(d.message); this.checked = !this.checked; }
            });
        });
        document.getElementById('deleteModal')?.addEventListener('show.bs.modal', function(e) {
            const b = e.relatedTarget;
            document.getElementById('deleteId').value = b.dataset.id;
            document.getElementById('deleteName').textContent = b.dataset.name;
        });
    </script>
}