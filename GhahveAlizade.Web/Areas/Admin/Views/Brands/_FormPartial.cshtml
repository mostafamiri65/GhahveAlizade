@model BrandFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-12">
        <h6 class="text-muted border-bottom pb-2 mb-3">اطلاعات اصلی</h6>
    </div>

    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" type="number" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" dir="ltr" placeholder="خودکار از نام" />
    </div>

    <div class="col-md-6">
        <label asp-for="CountryOfOrigin" class="form-label"></label>
        <input asp-for="CountryOfOrigin" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="LogoUrl" class="form-label"></label>
        <input asp-for="LogoUrl" class="form-control" dir="ltr" placeholder="/uploads/brands/..." />
    </div>

    <div class="col-md-6">
        <label asp-for="WebsiteUrl" class="form-label"></label>
        <input asp-for="WebsiteUrl" class="form-control" dir="ltr" placeholder="https://..." />
        <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
    </div>

    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
        <div class="form-check form-switch">
            <input asp-for="IsFeatured" class="form-check-input" />
            <label asp-for="IsFeatured" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-12 mt-4">
        <h6 class="text-muted border-bottom pb-2 mb-3"><i class="bi bi-search"></i> تنظیمات سئو</h6>
    </div>

    <div class="col-12">
        <label asp-for="MetaTitle" class="form-label"></label>
        <input asp-for="MetaTitle" class="form-control" maxlength="200" />
    </div>

    <div class="col-12">
        <label asp-for="MetaDescription" class="form-label"></label>
        <textarea asp-for="MetaDescription" rows="2" class="form-control" maxlength="500"></textarea>
    </div>

    <div class="col-12">
        <label asp-for="MetaKeywords" class="form-label"></label>
        <input asp-for="MetaKeywords" class="form-control" maxlength="500" />
    </div>

    <div class="col-md-6">
        <label asp-for="CanonicalUrl" class="form-label"></label>
        <input asp-for="CanonicalUrl" class="form-control" dir="ltr" />
    </div>

    <div class="col-md-6">
        <label asp-for="OgImage" class="form-label"></label>
        <input asp-for="OgImage" class="form-control" dir="ltr" />
    </div>
</div>