@model PaginatedList<BrandListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Catalog.Brands.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "مدیریت برندها";
    ViewData["PageIcon"] = "bi-award";
    var search = ViewBag.Search as string;
    var isActive = ViewBag.IsActive as bool?;
    var isFeatured = ViewBag.IsFeatured as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <span class="text-muted">مجموع: <strong>@Model.TotalCount</strong> برند</span>

    @if (User.HasPermission(Permissions.Brands.Create))
    {
        <a asp-action="Create" class="btn btn-admin-primary">
            <i class="bi bi-plus-lg"></i> افزودن برند
        </a>
    }
</div>

<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control" value="@search" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">وضعیت</label>
            <select name="isActive" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isActive == true)">فعال</option>
                <option value="false" selected="@(isActive == false)">غیرفعال</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">ویژه</label>
            <select name="isFeatured" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isFeatured == true)">بله</option>
                <option value="false" selected="@(isFeatured == false)">خیر</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">مرتب‌سازی</label>
            <select name="sortBy" class="form-select">
                <option value="displayOrder" selected="@(ViewBag.SortBy == "displayOrder")">ترتیب</option>
                <option value="name" selected="@(ViewBag.SortBy == "name")">نام</option>
                <option value="createdAt" selected="@(ViewBag.SortBy == "createdAt")">تاریخ ایجاد</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search"></i> فیلتر
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-award"></i></div>
            <h5 class="text-muted">برندی یافت نشد</h5>
            @if (User.HasPermission(Permissions.Brands.Create))
            {
                <a asp-action="Create" class="btn btn-admin-primary mt-2">
                    <i class="bi bi-plus-lg"></i> افزودن اولین برند
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">لوگو</th>
                        <th>نام</th>
                        <th>کشور</th>
                        <th class="text-center">محصولات</th>
                        <th class="text-center">ترتیب</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 150px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(b.LogoUrl))
                                {
                                    <img src="@b.LogoUrl" alt="@b.Name"
                                         style="width: 45px; height: 45px; object-fit: contain; border-radius: 6px; background: #f9fafb;" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                         style="width: 45px; height: 45px; border-radius: 6px;">
                                        <i class="bi bi-award text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@b.Name</div>
                                <small class="text-muted">@b.Slug</small>
                                @if (b.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark ms-1">ویژه</span>
                                }
                            </td>
                            <td class="small text-muted">@(b.CountryOfOrigin ?? "—")</td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@b.ProductCount</span>
                            </td>
                            <td class="text-center text-muted small">@b.DisplayOrder</td>
                            <td class="text-center">
                                @if (User.HasPermission(Permissions.Brands.Edit))
                                {
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-active" type="checkbox"
                                               data-id="@b.Id" @(b.IsActive ? "checked" : "") />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge @(b.IsActive ? "bg-success" : "bg-secondary")">
                                        @(b.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (User.HasPermission(Permissions.Brands.Edit))
                                    {
                                        <a asp-action="Edit" asp-route-id="@b.Id"
                                           class="btn btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (User.HasPermission(Permissions.Brands.Delete))
                                    {
                                        <button type="button" class="btn btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                data-id="@b.Id" data-name="@b.Name">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @if (Model.HasPrevious)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-search="@search">قبلی</a>
                            </li>
                        }
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == 1 || i == Model.TotalPages || (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-search="@search">@i</a>
                                </li>
                            }
                            else if (i == Model.PageNumber - 3 || i == Model.PageNumber + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        @if (Model.HasNext)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-search="@search">بعدی</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header">
                    <h5 class="modal-title">تایید حذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    آیا از حذف برند <strong id="deleteName" class="text-danger"></strong> مطمئن هستید؟
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        document.querySelectorAll('.toggle-active').forEach(el => {
            el.addEventListener('change', async function () {
                const id = this.dataset.id;
                try {
                    const r = await fetch('@Url.Action("ToggleActive")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                        body: `id=${id}&__RequestVerificationToken=${token}`
                    });
                    const data = await r.json();
                    if (!data.success) { alert(data.message); this.checked = !this.checked; }
                } catch { alert('خطا'); this.checked = !this.checked; }
            });
        });

        const deleteModal = document.getElementById('deleteModal');
        deleteModal?.addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteId').value = btn.dataset.id;
            document.getElementById('deleteName').textContent = btn.dataset.name;
        });
    </script>
}