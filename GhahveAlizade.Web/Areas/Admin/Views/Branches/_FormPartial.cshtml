@using GhahveAlizade.Web.Areas.Admin.Models.Inventory
@model BranchFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <!-- اطلاعات اصلی -->
    <div class="col-12">
        <h6 class="text-muted border-bottom pb-2 mb-3">اطلاعات اصلی</h6>
    </div>

    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" dir="ltr" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" dir="ltr" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="WorkingHours" class="form-label"></label>
        <input asp-for="WorkingHours" class="form-control" placeholder="۹ صبح تا ۹ شب" />
    </div>

    <div class="col-md-4">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" type="number" class="form-control" />
    </div>

    <!-- آدرس -->
    <div class="col-12 mt-4">
        <h6 class="text-muted border-bottom pb-2 mb-3">آدرس و موقعیت</h6>
    </div>

    <div class="col-md-4">
        <label asp-for="Province" class="form-label"></label>
        <input asp-for="Province" class="form-control" />
    </div>

    <div class="col-md-4">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" />
    </div>

    <div class="col-md-4">
        <label asp-for="PostalCode" class="form-label"></label>
        <input asp-for="PostalCode" class="form-control" dir="ltr" />
    </div>

    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" rows="2" class="form-control"></textarea>
    </div>

    <div class="col-md-6">
        <label asp-for="Latitude" class="form-label"></label>
        <input asp-for="Latitude" type="number" step="0.0000001" class="form-control" dir="ltr" />
        <span asp-validation-for="Latitude" class="text-danger small"></span>
        <small class="text-muted">مثال: 35.6892</small>
    </div>

    <div class="col-md-6">
        <label asp-for="Longitude" class="form-label"></label>
        <input asp-for="Longitude" type="number" step="0.0000001" class="form-control" dir="ltr" />
        <span asp-validation-for="Longitude" class="text-danger small"></span>
        <small class="text-muted">مثال: 51.3890</small>
    </div>

    <!-- وضعیت -->
    <div class="col-12 mt-4">
        <h6 class="text-muted border-bottom pb-2 mb-3">وضعیت</h6>
        <div class="d-flex flex-wrap gap-4">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="IsDefault" class="form-check-input" />
                <label asp-for="IsDefault" class="form-check-label"></label>
                <small class="text-muted d-block">فقط یک شعبه می‌تواند پیش‌فرض باشد.</small>
            </div>
        </div>
    </div>
</div>