@model PaginatedList<BranchListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Inventory.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "شعبه‌ها";
    ViewData["PageIcon"] = "bi-shop";
    var search = ViewBag.Search as string;
    var isActive = ViewBag.IsActive as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <span class="text-muted">مجموع: <strong>@Model.TotalCount</strong> شعبه</span>

    @if (User.HasPermission(Permissions.Inventory.ManageBranches))
    {
        <a asp-action="Create" class="btn btn-admin-primary">
            <i class="bi bi-plus-lg"></i> افزودن شعبه
        </a>
    }
</div>

<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control"
                   placeholder="نام، کد، شهر یا تلفن..." value="@search" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">وضعیت</label>
            <select name="isActive" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isActive == true)">فعال</option>
                <option value="false" selected="@(isActive == false)">غیرفعال</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search"></i> فیلتر
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </form>
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-shop"></i></div>
            <h5 class="text-muted">شعبه‌ای یافت نشد</h5>
            @if (User.HasPermission(Permissions.Inventory.ManageBranches))
            {
                <a asp-action="Create" class="btn btn-admin-primary mt-2">
                    <i class="bi bi-plus-lg"></i> افزودن اولین شعبه
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>نام</th>
                        <th>کد</th>
                        <th>موقعیت</th>
                        <th>تلفن</th>
                        <th>ساعات کاری</th>
                        <th class="text-center">ترتیب</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 150px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@b.Name</div>
                                @if (b.IsDefault)
                                {
                                    <span class="badge bg-success small">پیش‌فرض</span>
                                }
                            </td>
                            <td><code class="small">@b.Code</code></td>
                            <td class="small text-muted">
                                @if (!string.IsNullOrEmpty(b.City))
                                {
                                    <i class="bi bi-geo-alt"></i>
                                    @b.City
                                    @if (!string.IsNullOrEmpty(b.Province))
                                    {
                                        <span>, @b.Province</span>
                                    }
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="small" dir="ltr">
                                @if (!string.IsNullOrEmpty(b.Phone))
                                {
                                    <a href="tel:@b.Phone">@b.Phone</a>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td class="small text-muted">@(b.WorkingHours ?? "—")</td>
                            <td class="text-center text-muted small">@b.DisplayOrder</td>
                            <td class="text-center">
                                @if (User.HasPermission(Permissions.Inventory.ManageBranches))
                                {
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-active" type="checkbox"
                                               data-id="@b.Id" @(b.IsActive ? "checked" : "") />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge @(b.IsActive ? "bg-success" : "bg-secondary")">
                                        @(b.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (User.HasPermission(Permissions.Inventory.ManageBranches))
                                    {
                                        <a asp-action="Edit" asp-route-id="@b.Id"
                                           class="btn btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (!b.IsDefault)
                                        {
                                            <button type="button" class="btn btn-outline-danger"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                    data-id="@b.Id" data-name="@b.Name" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @if (Model.HasPrevious)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-search="@search">قبلی</a>
                            </li>
                        }
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == 1 || i == Model.TotalPages ||
                                (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageNumber="@i"
                                       asp-route-search="@search">@i</a>
                                </li>
                            }
                        }
                        @if (Model.HasNext)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-search="@search">بعدی</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header">
                    <h5 class="modal-title">تایید حذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    آیا از حذف شعبه <strong id="deleteName" class="text-danger"></strong> مطمئن هستید؟
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        document.querySelectorAll('.toggle-active').forEach(el => {
            el.addEventListener('change', async function() {
                const id = this.dataset.id;
                try {
                    const r = await fetch('@Url.Action("ToggleActive")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: `id=${id}&__RequestVerificationToken=${token}`
                    });
                    const d = await r.json();
                    if (!d.success) { alert(d.message); this.checked = !this.checked; }
                } catch { alert('خطا'); this.checked = !this.checked; }
            });
        });

        document.getElementById('deleteModal')?.addEventListener('show.bs.modal', function(e) {
            const b = e.relatedTarget;
            document.getElementById('deleteId').value = b.dataset.id;
            document.getElementById('deleteName').textContent = b.dataset.name;
        });
    </script>
}