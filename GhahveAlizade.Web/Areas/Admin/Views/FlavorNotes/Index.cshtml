@model PaginatedList<FlavorNoteListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Coffee.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "نُت‌های طعمی";
    ViewData["PageIcon"] = "bi-flower1";
    var search = ViewBag.Search as string;
    var category = ViewBag.Category as string;
    var isActive = ViewBag.IsActive as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <span class="text-muted">مجموع: <strong>@Model.TotalCount</strong> نُت طعمی</span>

    @if (User.HasPermission(Permissions.Coffee.ManageFlavorNotes))
    {
        <a asp-action="Create" class="btn btn-admin-primary">
            <i class="bi bi-plus-lg"></i> افزودن نُت طعمی
        </a>
    }
</div>

<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control"
                   placeholder="نام یا نامک..." value="@search" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">دسته</label>
            <select name="category" class="form-select">
                <option value="">همه</option>
                @foreach (var cat in new[] { "Chocolate", "Fruity", "Citrus", "Nutty", "Floral", "Spicy", "Sweet", "Other" })
                {
                    <option value="@cat" selected="@(category == cat)">@cat</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">وضعیت</label>
            <select name="isActive" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isActive == true)">فعال</option>
                <option value="false" selected="@(isActive == false)">غیرفعال</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search"></i> فیلتر
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </form>
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-flower1"></i></div>
            <h5 class="text-muted">نُت طعمی یافت نشد</h5>
            @if (User.HasPermission(Permissions.Coffee.ManageFlavorNotes))
            {
                <a asp-action="Create" class="btn btn-admin-primary mt-2">
                    <i class="bi bi-plus-lg"></i> افزودن اولین نُت طعمی
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">رنگ</th>
                        <th>نام</th>
                        <th>دسته</th>
                        <th>نامک</th>
                        <th class="text-center">محصولات</th>
                        <th class="text-center">ترتیب</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 150px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(f.ColorCode))
                                {
                                    <div style="width: 40px; height: 40px; border-radius: 50%;
                                        background-color: @f.ColorCode;
                                        border: 2px solid #e5e7eb;"
                                         title="@f.ColorCode">
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                         style="width: 40px; height: 40px; border-radius: 50%;">
                                        <i class="bi bi-flower1 text-success"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-bold">@f.Name</td>
                            <td>
                                @if (!string.IsNullOrEmpty(f.Category))
                                {
                                    <span class="badge bg-info text-dark">@f.Category</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><code class="small text-muted">@f.Slug</code></td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@f.ProductCount</span>
                            </td>
                            <td class="text-center text-muted small">@f.DisplayOrder</td>
                            <td class="text-center">
                                @if (User.HasPermission(Permissions.Coffee.ManageFlavorNotes))
                                {
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-active" type="checkbox"
                                               data-id="@f.Id" @(f.IsActive ? "checked" : "") />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge @(f.IsActive ? "bg-success" : "bg-secondary")">
                                        @(f.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (User.HasPermission(Permissions.Coffee.ManageFlavorNotes))
                                    {
                                        <a asp-action="Edit" asp-route-id="@f.Id"
                                           class="btn btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                data-id="@f.Id" data-name="@f.Name" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @if (Model.HasPrevious)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-search="@search"
                                   asp-route-category="@category">قبلی</a>
                            </li>
                        }
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@i"
                                   asp-route-search="@search"
                                   asp-route-category="@category">@i</a>
                            </li>
                        }
                        @if (Model.HasNext)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-search="@search"
                                   asp-route-category="@category">بعدی</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header">
                    <h5 class="modal-title">تایید حذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    آیا از حذف نُت طعمی <strong id="deleteName" class="text-danger"></strong> مطمئن هستید؟
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        document.querySelectorAll('.toggle-active').forEach(el => {
            el.addEventListener('change', async function() {
                const id = this.dataset.id;
                try {
                    const r = await fetch('@Url.Action("ToggleActive")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: `id=${id}&__RequestVerificationToken=${token}`
                    });
                    const d = await r.json();
                    if (!d.success) { alert(d.message); this.checked = !this.checked; }
                } catch { alert('خطا'); this.checked = !this.checked; }
            });
        });

        document.getElementById('deleteModal')?.addEventListener('show.bs.modal', function(e) {
            const b = e.relatedTarget;
            document.getElementById('deleteId').value = b.dataset.id;
            document.getElementById('deleteName').textContent = b.dataset.name;
        });
    </script>
}