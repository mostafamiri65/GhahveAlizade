@model PaginatedList<NewsletterSubscriberListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Newsletter.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "خبرنامه";
    ViewData["PageIcon"] = "bi-envelope";
    var search = ViewBag.Search as string;
    var isActive = ViewBag.IsActive as bool?;
    var isVerified = ViewBag.IsVerified as bool?;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <span class="text-muted">مجموع: <strong>@Model.TotalCount</strong> مشترک</span>
    @if (User.HasPermission(Permissions.Newsletter.Export))
    {
        <a asp-action="Export" class="btn btn-outline-success">
            <i class="bi bi-download"></i> خروجی CSV
        </a>
    }
</div>

<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control" value="@search" placeholder="ایمیل، نام، موبایل..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small">وضعیت</label>
            <select name="isActive" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isActive == true)">فعال</option>
                <option value="false" selected="@(isActive == false)">غیرفعال</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">تایید</label>
            <select name="isVerified" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isVerified == true)">تایید شده</option>
                <option value="false" selected="@(isVerified == false)">تایید نشده</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search"></i> فیلتر</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-envelope"></i></div>
            <h5 class="text-muted">مشترکی یافت نشد</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ایمیل</th>
                        <th>نام</th>
                        <th>موبایل</th>
                        <th class="text-center">منبع</th>
                        <th class="text-center">تاریخ عضویت</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 130px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Items)
                    {
                        <tr>
                            <td dir="ltr" class="text-end small">
                                @s.Email
                                @if (s.IsVerified)
                                {
                                    <i class="bi bi-patch-check-fill text-info ms-1" title="تایید شده"></i>
                                }
                            </td>
                            <td class="small">@($"{s.FirstName} {s.LastName}".Trim())</td>
                            <td class="small" dir="ltr">@s.PhoneNumber</td>
                            <td class="text-center small text-muted">@(s.Source ?? "—")</td>
                            <td class="text-center small text-muted">
                                @if (s.SubscribedAtUtc.HasValue)
                                {
                                    @s.SubscribedAtUtc.Value.ToLocalTime().ToString("yyyy/MM/dd")
                                }
                                else
                                {
                                    @s.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd")
                                }
                            </td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block">
                                    <input class="form-check-input toggle-active" type="checkbox"
                                           data-id="@s.Id" @(s.IsActive ? "checked" : "") />
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (!s.IsVerified)
                                    {
                                        <button type="button" class="btn btn-outline-info"
                                                onclick="verifySubscriber(@s.Id)" title="تایید">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-danger"
                                            onclick="deleteSubscriber(@s.Id)" title="حذف">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        document.querySelectorAll('.toggle-active').forEach(el => {
            el.addEventListener('change', async function() {
                const id = this.dataset.id;
                const r = await fetch('@Url.Action("ToggleActive")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: `id=${id}&__RequestVerificationToken=${token}`
                });
                const d = await r.json();
                if (!d.success) { alert(d.message); this.checked = !this.checked; }
            });
        });

        async function verifySubscriber(id) {
            const r = await fetch('@Url.Action("Verify")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: `id=${id}&__RequestVerificationToken=${token}`
            });
            const d = await r.json();
            if (d.success) location.reload();
        }

        async function deleteSubscriber(id) {
            if (!confirm('حذف این مشترک؟')) return;
            const r = await fetch('@Url.Action("Delete")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: `id=${id}&__RequestVerificationToken=${token}`
            });
            const d = await r.json();
            if (d.success) location.reload();
        }
    </script>
}