@model CouponFormViewModel


<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" dir="ltr" style="text-transform: uppercase;" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DiscountType" class="form-label"></label>
        <select asp-for="DiscountType" class="form-select" id="discountType">
            <option value="1">درصدی</option>
            <option value="2">مبلغ ثابت</option>
            <option value="3">ارسال رایگان</option>
        </select>
    </div>
    <div class="col-md-4">
        <label asp-for="DiscountValue" class="form-label"></label>
        <input asp-for="DiscountValue" type="number" step="0.01" class="form-control" dir="ltr" id="discountValue" />
        <span asp-validation-for="DiscountValue" class="text-danger small"></span>
        <small class="text-muted" id="discountHint"></small>
    </div>

    <div class="col-md-6">
        <label asp-for="MaxDiscountAmount" class="form-label"></label>
        <input asp-for="MaxDiscountAmount" type="number" step="1000" class="form-control" dir="ltr" />
    </div>
    <div class="col-md-6">
        <label asp-for="MinOrderAmount" class="form-label"></label>
        <input asp-for="MinOrderAmount" type="number" step="1000" class="form-control" dir="ltr" />
    </div>

    <div class="col-md-6">
        <label asp-for="MaxUsageCount" class="form-label"></label>
        <input asp-for="MaxUsageCount" type="number" class="form-control" dir="ltr" />
    </div>
    <div class="col-md-6">
        <label asp-for="MaxUsagePerCustomer" class="form-label"></label>
        <input asp-for="MaxUsagePerCustomer" type="number" class="form-control" dir="ltr" />
    </div>

    <!-- ⬇️ تاریخ‌ها با Date Picker شمسی -->
    <div class="col-md-6">
        <label asp-for="StartsAtUtc" class="form-label"></label>
        <input type="text" id="startsAtPicker" class="form-control" dir="ltr"
               placeholder="1403/01/01" readonly autocomplete="off" />
        <input type="hidden" id="startsAtHidden" name="StartsAtUtc"
               value="@(Model.StartsAtUtc?.ToString("yyyy-MM-ddTHH:mm:ss"))" />
    </div>
    <div class="col-md-6">
        <label asp-for="ExpiresAtUtc" class="form-label"></label>
        <input type="text" id="expiresAtPicker" class="form-control" dir="ltr"
               placeholder="1403/01/01" readonly autocomplete="off" />
        <input type="hidden" id="expiresAtHidden" name="ExpiresAtUtc"
               value="@(Model.ExpiresAtUtc?.ToString("yyyy-MM-ddTHH:mm:ss"))" />
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="2" class="form-control"></textarea>
    </div>

    <div class="col-12">
        <div class="d-flex flex-wrap gap-4">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="IsFirstOrderOnly" class="form-check-input" />
                <label asp-for="IsFirstOrderOnly" class="form-check-label"></label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="IsPublic" class="form-check-input" />
                <label asp-for="IsPublic" class="form-check-label"></label>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        'use strict';

        // ============ Hint برای DiscountValue ============
        const discountTypeEl = document.getElementById('discountType');
        const discountValueEl = document.getElementById('discountValue');
        const discountHintEl = document.getElementById('discountHint');

        function updateDiscountHint() {
            if (!discountTypeEl || !discountHintEl) return;
            const type = parseInt(discountTypeEl.value);
            if (type === 1) {
                discountHintEl.textContent = 'درصد تخفیف (0.01 تا 100)';
                discountValueEl.max = 100;
                discountValueEl.min = 0.01;
            } else if (type === 2) {
                discountHintEl.textContent = 'مبلغ به تومان';
                discountValueEl.removeAttribute('max');
                discountValueEl.min = 0;
            } else {
                discountHintEl.textContent = '';
                discountValueEl.removeAttribute('max');
            }
        }

        discountTypeEl?.addEventListener('change', updateDiscountHint);
        updateDiscountHint();

        // ============ Jalali Date Picker ============
        function initJalaliPicker(pickerId, hiddenId) {
            const picker = document.getElementById(pickerId);
            const hidden = document.getElementById(hiddenId);
            if (!picker || !hidden) return;

            // اگه مقدار داشت، تبدیل به شمسی کن
            if (hidden.value) {
                try {
                    const d = new Date(hidden.value);
                    if (!isNaN(d.getTime())) {
                        const pd = new persianDate(d);
                        picker.value = pd.format('YYYY/MM/DD');
                    }
                } catch (e) {
                    console.error('Error parsing date:', e);
                }
            }

            // Init date picker
            $(picker).persianDatepicker({
                format: 'YYYY/MM/DD',
                initialValue: false,
                autoClose: true,
                position: 'auto',
                observer: true,
                calendar: {
                    persian: {
                        locale: 'fa',
                        leapYearMode: 'algorithmic'
                    }
                },
                onSelect: function(unix) {
                    // unix timestamp → میلادی
                    const gregorian = new persianDate(unix).toCalendar('gregorian').toDate();
                    // فرمت: yyyy-MM-ddTHH:mm:ss
                    const iso = gregorian.getFullYear() + '-' +
                        String(gregorian.getMonth() + 1).padStart(2, '0') + '-' +
                        String(gregorian.getDate()).padStart(2, '0') + 'T' +
                        String(gregorian.getHours()).padStart(2, '0') + ':' +
                        String(gregorian.getMinutes()).padStart(2, '0') + ':' +
                        String(gregorian.getSeconds()).padStart(2, '0');
                    hidden.value = iso;
                }
            });

            // پاک‌کردن
            picker.addEventListener('dblclick', function() {
                picker.value = '';
                hidden.value = '';
            });
        }

        // ============ Init on DOM Ready ============
        document.addEventListener('DOMContentLoaded', function() {
            // بررسی وجود persianDate
            if (typeof persianDate === 'undefined' || typeof $ === 'undefined') {
                console.error('persian-datepicker or jQuery not loaded');
                return;
            }
            initJalaliPicker('startsAtPicker', 'startsAtHidden');
            initJalaliPicker('expiresAtPicker', 'expiresAtHidden');
        });
    })();
</script>