@using GhahveAlizade.Web.Areas.Admin.Models.Content
@model BlogTagFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" dir="ltr" />
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="2" class="form-control"></textarea>
    </div>
</div>