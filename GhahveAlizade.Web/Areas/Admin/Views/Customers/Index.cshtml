@model PaginatedList<CustomerListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Customers.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "مشتریان";
    ViewData["PageIcon"] = "bi-people";
    var search = ViewBag.Search as string;
    var customerGroupId = ViewBag.CustomerGroupId as long?;
    var isActive = ViewBag.IsActive as bool?;
    var isVerified = ViewBag.IsVerified as bool?;
    var hasOrders = ViewBag.HasOrders as bool?;
    var groups = ViewBag.Groups as List<CustomerGroupDto> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">مجموع: <strong>@Model.TotalCount</strong> مشتری</span>
    @if (User.HasPermission(Permissions.Customers.Export))
    {
        <a asp-action="Export" class="btn btn-outline-success">
            <i class="bi bi-download"></i> خروجی CSV
        </a>
    }
</div>

<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control"
                   placeholder="نام، موبایل، ایمیل..." value="@search" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">گروه</label>
            <select name="customerGroupId" class="form-select">
                <option value="">همه</option>
                @foreach (var g in groups)
                {
                    <option value="@g.Id" selected="@(customerGroupId == g.Id)">@g.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">وضعیت</label>
            <select name="isActive" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isActive == true)">فعال</option>
                <option value="false" selected="@(isActive == false)">غیرفعال</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">سفارش</label>
            <select name="hasOrders" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(hasOrders == true)">دارای سفارش</option>
                <option value="false" selected="@(hasOrders == false)">بدون سفارش</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search"></i> فیلتر
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-people"></i></div>
            <h5 class="text-muted">مشتری‌ای یافت نشد</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;"></th>
                        <th>نام</th>
                        <th>تماس</th>
                        <th class="text-center">گروه</th>
                        <th class="text-center">سفارشات</th>
                        <th class="text-center">مجموع خرید</th>
                        <th class="text-center">آخرین خرید</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center" style="width: 110px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="rounded-circle bg-warning d-flex align-items-center justify-content-center"
                                     style="width: 42px; height: 42px; color: white; font-weight: bold;">
                                    @(!string.IsNullOrEmpty(c.FullName) ? c.FullName[0].ToString() : "؟")
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold">@(string.IsNullOrEmpty(c.FullName) ? "بدون نام" : c.FullName)</div>
                                @if (c.IsVerified)
                                {
                                    <i class="bi bi-patch-check-fill text-info small" title="تایید شده"></i>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(c.PhoneNumber))
                                {
                                    <div dir="ltr" class="text-end">
                                        <i class="bi bi-telephone"></i> @c.PhoneNumber
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(c.Email))
                                {
                                    <div class="text-muted">@c.Email</div>
                                }
                            </td>
                            <td class="text-center small">
                                @if (!string.IsNullOrEmpty(c.CustomerGroupName))
                                {
                                    <span class="badge bg-info text-dark">@c.CustomerGroupName</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@c.TotalOrders</span>
                            </td>
                            <td class="text-center fw-bold small">
                                @c.TotalSpent.ToString("N0")
                                <small class="text-muted">تومان</small>
                            </td>
                            <td class="text-center small text-muted">
                                @if (c.LastOrderAtUtc.HasValue)
                                {
                                    @c.LastOrderAtUtc.Value.ToLocalTime().ToString("yyyy/MM/dd")
                                }
                                else
                                {
                                    <span>هرگز</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (User.HasPermission(Permissions.Customers.Edit))
                                {
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-active" type="checkbox"
                                               data-id="@c.Id" @(c.IsActive ? "checked" : "") />
                                    </div>
                                }
                                else
                                {
                                    <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">
                                        @(c.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detail" asp-route-id="@c.Id"
                                       class="btn btn-outline-info" title="جزئیات">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.HasPermission(Permissions.Customers.Edit))
                                    {
                                        <a asp-action="Edit" asp-route-id="@c.Id"
                                           class="btn btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        @if (Model.HasPrevious)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-search="@search">قبلی</a>
                            </li>
                        }
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.PageNumber) <= 2)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-search="@search">@i</a>
                                </li>
                            }
                        }
                        @if (Model.HasNext)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-search="@search">بعدی</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        document.querySelectorAll('.toggle-active').forEach(el => {
            el.addEventListener('change', async function() {
                const id = this.dataset.id;
                const r = await fetch('@Url.Action("ToggleActive")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: `id=${id}&__RequestVerificationToken=${token}`
                });
                const d = await r.json();
                if (!d.success) { alert(d.message); this.checked = !this.checked; }
            });
        });
    </script>
}