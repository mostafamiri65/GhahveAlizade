@using GhahveAlizade.Web.Areas.Admin.Models.Customers
@model CustomerEditViewModel
@{
    ViewData["Title"] = "ویرایش مشتری";
    ViewData["PageIcon"] = "bi-pencil";
}

<div class="admin-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" autofocus />
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" dir="ltr" />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" dir="ltr" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="NationalCode" class="form-label"></label>
                <input asp-for="NationalCode" class="form-control" dir="ltr" />
            </div>
            <div class="col-md-4">
                <label asp-for="BirthDate" class="form-label"></label>
                <input asp-for="BirthDate" type="date" class="form-control" dir="ltr" />
            </div>
            <div class="col-md-4">
                <label asp-for="Gender" class="form-label"></label>
                <select asp-for="Gender" class="form-select">
                    <option value="">— انتخاب —</option>
                    <option value="Male">مرد</option>
                    <option value="Female">زن</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="CustomerGroupId" class="form-label"></label>
                <select asp-for="CustomerGroupId" class="form-select">
                    <option value="">— بدون گروه —</option>
                    @foreach (var g in Model.Groups)
                    {
                        <option value="@g.Id" selected="@(Model.CustomerGroupId == g.Id)">@g.Name</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <div class="d-flex flex-wrap gap-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsVerified" class="form-check-input" />
                        <label asp-for="IsVerified" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="AcceptsMarketing" class="form-check-input" />
                        <label asp-for="AcceptsMarketing" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
            <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i> انصراف
            </a>
            <button type="submit" class="btn btn-admin-primary">
                <i class="bi bi-check-lg"></i> ذخیره
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}