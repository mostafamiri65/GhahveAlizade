@model CustomerDto
@using GhahveAlizade.Application.Features.Commerce.Dtos
@using GhahveAlizade.Application.Features.Customers.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = $"مشتری: {Model.FullName}";
    ViewData["PageIcon"] = "bi-person";
    var orders = ViewBag.Orders as List<OrderListItemDto>;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right"></i> بازگشت
    </a>
    @if (User.HasPermission(Permissions.Customers.Edit))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-admin-primary">
            <i class="bi bi-pencil"></i> ویرایش
        </a>
    }
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <!-- اطلاعات اصلی -->
        <div class="admin-card mb-3">
            <h6 class="fw-bold mb-3">اطلاعات مشتری</h6>
            <div class="row g-2 small">
                <div class="col-md-6"><strong>نام کامل:</strong> @(Model.FullName ?? "—")</div>
                <div class="col-md-6"><strong>موبایل:</strong> <span dir="ltr">@(Model.PhoneNumber ?? "—")</span></div>
                <div class="col-md-6"><strong>ایمیل:</strong> @(Model.Email ?? "—")</div>
                <div class="col-md-6"><strong>کد ملی:</strong> @(Model.NationalCode ?? "—")</div>
                <div class="col-md-6"><strong>جنسیت:</strong> @(Model.Gender ?? "—")</div>
                <div class="col-md-6"><strong>تاریخ تولد:</strong> @(Model.BirthDate?.ToString("yyyy/MM/dd") ?? "—")</div>
                <div class="col-md-6"><strong>عضویت:</strong> @Model.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd")</div>
                <div class="col-md-6"><strong>آخرین ورود:</strong> @(Model.LastLoginAtUtc?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "هرگز")</div>
            </div>
        </div>

        <!-- سفارشات -->
        @if (orders is not null && orders.Any())
        {
            <div class="admin-card mb-3">
                <h6 class="fw-bold mb-3">سفارشات (@orders.Count)</h6>
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>شماره</th>
                                <th class="text-center">تعداد اقلام</th>
                                <th class="text-center">مبلغ</th>
                                <th class="text-center">وضعیت</th>
                                <th class="text-center">تاریخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in orders)
                            {
                                <tr>
                                    <td>
                                        <a href="/admin/orders/detail/@o.Id" dir="ltr">@o.OrderNumber</a>
                                    </td>
                                    <td class="text-center">@o.ItemCount</td>
                                    <td class="text-center fw-bold">@o.Total.ToString("N0")</td>
                                    <td class="text-center"><span class="badge bg-secondary">@o.StatusName</span></td>
                                    <td class="text-center small text-muted">
                                        @o.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- یادداشت‌ها -->
        @if (User.HasPermission(Permissions.Customers.ManageNotes))
        {
            <div class="admin-card mb-3">
                <h6 class="fw-bold mb-3">یادداشت‌های داخلی</h6>
                <div class="mb-3">
                    <textarea id="noteContent" rows="2" class="form-control" placeholder="متن یادداشت..."></textarea>
                    <div class="d-flex gap-2 mt-2">
                        <input id="noteCategory" class="form-control form-control-sm" placeholder="دسته (اختیاری)" style="width: 200px;" />
                        <div class="form-check form-switch">
                            <input type="checkbox" id="noteInternal" class="form-check-input" checked />
                            <label for="noteInternal" class="form-check-label small">داخلی</label>
                        </div>
                        <button type="button" class="btn btn-sm btn-admin-primary ms-auto" onclick="addNote()">
                            <i class="bi bi-plus-lg"></i> افزودن
                        </button>
                    </div>
                </div>

                @if (Model.Notes.Any())
                {
                    @foreach (var note in Model.Notes)
                    {
                        <div class="border rounded p-2 mb-2 bg-light">
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">
                                    @note.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                                    @if (!string.IsNullOrEmpty(note.CreatedBy))
                                    {
                                        <span> - @note.CreatedBy</span>
                                    }
                                    @if (!string.IsNullOrEmpty(note.Category))
                                    {
                                        <span class="badge bg-secondary ms-1">@note.Category</span>
                                    }
                                </small>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                        onclick="deleteNote(@note.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <div class="mt-1 small">@note.Content</div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small text-center py-3">یادداشتی ثبت نشده است.</p>
                }
            </div>
        }
    </div>

    <!-- ستون راست -->
    <div class="col-lg-4">
        <div class="admin-card mb-3">
            <div class="text-center">
                <div class="rounded-circle bg-warning mx-auto d-flex align-items-center justify-content-center"
                     style="width: 100px; height: 100px; color: white; font-size: 2.5rem; font-weight: bold;">
                    @(!string.IsNullOrEmpty(Model.FullName) ? Model.FullName[0].ToString() : "؟")
                </div>
                <h5 class="mt-3 mb-1">@(string.IsNullOrEmpty(Model.FullName) ? "بدون نام" : Model.FullName)</h5>
                @if (!string.IsNullOrEmpty(Model.CustomerGroupName))
                {
                    <span class="badge bg-info text-dark">@Model.CustomerGroupName</span>
                }
            </div>
        </div>

        <div class="admin-card mb-3">
            <h6 class="fw-bold mb-3">آمار</h6>
            <ul class="list-unstyled small mb-0">
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span>تعداد سفارش:</span>
                    <strong>@Model.TotalOrders</strong>
                </li>
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span>مجموع خرید:</span>
                    <strong>@Model.TotalSpent.ToString("N0") تومان</strong>
                </li>
                <li class="d-flex justify-content-between py-2">
                    <span>آخرین خرید:</span>
                    <span>@(Model.LastOrderAtUtc?.ToLocalTime().ToString("yyyy/MM/dd") ?? "هرگز")</span>
                </li>
            </ul>
        </div>

        <div class="admin-card">
            <h6 class="fw-bold mb-3">وضعیت</h6>
            <ul class="list-unstyled small mb-0">
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span>فعال:</span>
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "بله" : "خیر")
                    </span>
                </li>
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span>تایید شده:</span>
                    <span class="badge @(Model.IsVerified ? "bg-success" : "bg-secondary")">
                        @(Model.IsVerified ? "بله" : "خیر")
                    </span>
                </li>
                <li class="d-flex justify-content-between py-2">
                    <span>پذیرش بازاریابی:</span>
                    <span class="badge @(Model.AcceptsMarketing ? "bg-success" : "bg-secondary")">
                        @(Model.AcceptsMarketing ? "بله" : "خیر")
                    </span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        async function addNote() {
            const content = document.getElementById('noteContent').value.trim();
            if (!content) { alert('متن یادداشت الزامی است'); return; }
            const category = document.getElementById('noteCategory').value;
            const isInternal = document.getElementById('noteInternal').checked;

            const body = new URLSearchParams();
            body.append('customerId', '@Model.Id');
            body.append('content', content);
            body.append('category', category);
            body.append('isInternal', isInternal);
            body.append('__RequestVerificationToken', token);

            const r = await fetch('@Url.Action("AddNote")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const d = await r.json();
            alert(d.message);
            if (d.success) location.reload();
        }

        async function deleteNote(id) {
            if (!confirm('حذف یادداشت؟')) return;
            const body = new URLSearchParams();
            body.append('id', id);
            body.append('__RequestVerificationToken', token);

            const r = await fetch('@Url.Action("DeleteNote")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const d = await r.json();
            if (d.success) location.reload();
        }
    </script>
}