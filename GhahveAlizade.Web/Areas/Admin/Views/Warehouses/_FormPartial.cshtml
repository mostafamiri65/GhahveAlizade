@using GhahveAlizade.Web.Areas.Admin.Models.Inventory
@model WarehouseFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" dir="ltr" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Province" class="form-label"></label>
        <input asp-for="Province" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="PostalCode" class="form-label"></label>
        <input asp-for="PostalCode" class="form-control" dir="ltr" />
    </div>

    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" dir="ltr" />
    </div>
    <div class="col-md-6">
        <label asp-for="ManagerName" class="form-label"></label>
        <input asp-for="ManagerName" class="form-control" />
    </div>

    <div class="col-12">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" rows="2" class="form-control"></textarea>
    </div>

    <div class="col-12">
        <div class="d-flex flex-wrap gap-4">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="IsDefault" class="form-check-input" />
                <label asp-for="IsDefault" class="form-check-label"></label>
            </div>
        </div>
    </div>
</div>