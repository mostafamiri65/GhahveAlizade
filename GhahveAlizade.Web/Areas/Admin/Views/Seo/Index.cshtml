@model PaginatedList<SeoMetadataListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Seo.Dtos
@using GhahveAlizade.Domain.Enums
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "متادیتای سئو";
    ViewData["PageIcon"] = "bi-search";
    var search = ViewBag.Search as string;
    var entityType = ViewBag.EntityType as SeoEntityType?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <span class="text-muted">مجموع: <strong>@Model.TotalCount</strong> متادیتا</span>
</div>

<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control" value="@search" />
        </div>
        <div class="col-md-3">
            <label class="form-label small">نوع</label>
            <select name="entityType" class="form-select">
                <option value="">همه</option>
                @foreach (SeoEntityType t in Enum.GetValues<SeoEntityType>())
                {
                    <option value="@((int)t)" selected="@(entityType == t)">@GetTypeName(t)</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search"></i> فیلتر</button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>
</div>

<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-search"></i></div>
            <h5 class="text-muted">متادیتایی یافت نشد</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>نوع</th>
                        <th>شناسه</th>
                        <th>زبان</th>
                        <th>عنوان</th>
                        <th class="text-center">Robots</th>
                        <th class="text-center">آخرین به‌روزرسانی</th>
                        <th class="text-center" style="width: 100px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-info text-dark">@s.EntityTypeName</span></td>
                            <td class="text-muted small">#@s.EntityId</td>
                            <td class="small text-uppercase">@s.Culture</td>
                            <td class="small">
                                <div class="fw-bold">@(s.MetaTitle ?? "—")</div>
                                <small class="text-muted">@(s.MetaDescription?.Length > 80 ? s.MetaDescription.Substring(0, 80) + "..." : s.MetaDescription ?? "")</small>
                            </td>
                            <td class="text-center small">@s.Robots</td>
                            <td class="text-center small text-muted">
                                @(s.UpdatedAtUtc?.ToLocalTime().ToString("yyyy/MM/dd") ?? s.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd"))
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    @if (User.HasPermission(Permissions.Seo.EditMetadata))
                                    {
                                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger"
                                                onclick="deleteMeta(@s.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    static string GetTypeName(SeoEntityType t) => t switch
    {
        SeoEntityType.HomePage => "صفحه اصلی",
        SeoEntityType.Product => "محصول",
        SeoEntityType.Category => "دسته‌بندی",
        SeoEntityType.Brand => "برند",
        SeoEntityType.BlogPost => "مقاله",
        SeoEntityType.BlogCategory => "دسته وبلاگ",
        SeoEntityType.BlogTag => "برچسب وبلاگ",
        SeoEntityType.LandingPage => "صفحه فرود",
        SeoEntityType.StaticPage => "صفحه ثابت",
        SeoEntityType.ProductBundle => "بسته",
        _ => t.ToString()
    };
}

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        async function deleteMeta(id) {
            if (!confirm('حذف این متادیتا؟')) return;
            const body = new URLSearchParams();
            body.append('id', id);
            body.append('__RequestVerificationToken', token);

            const r = await fetch('@Url.Action("Delete")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const d = await r.json().catch(() => ({ success: false }));
            if (d.success !== false) location.reload();
        }
    </script>
}