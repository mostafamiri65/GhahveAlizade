@model PaginatedList<ProductListItemDto>
@using GhahveAlizade.Application.Common.Models
@using GhahveAlizade.Application.Features.Catalog.Products.Dtos
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = "مدیریت محصولات";
    ViewData["PageIcon"] = "bi-box-seam";

    var search = ViewBag.Search as string;
    var categoryId = ViewBag.CategoryId as long?;
    var brandId = ViewBag.BrandId as long?;
    var coffeeOriginId = ViewBag.CoffeeOriginId as long?;
    var roastProfileId = ViewBag.RoastProfileId as long?;
    var isActive = ViewBag.IsActive as bool?;
    var isPublished = ViewBag.IsPublished as bool?;
    var isFeatured = ViewBag.IsFeatured as bool?;

    var categories = ViewBag.Categories as List<LookupItem> ?? new();
    var brands = ViewBag.Brands as List<LookupItem> ?? new();
    var origins = ViewBag.CoffeeOrigins as List<LookupItem> ?? new();
    var roasts = ViewBag.RoastProfiles as List<LookupItem> ?? new();
}

<!-- Header Actions -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="d-flex gap-2 align-items-center">
        <span class="text-muted">
            مجموع: <strong>@Model.TotalCount</strong> محصول
        </span>
    </div>

    @if (User.HasPermission(Permissions.Products.Create))
    {
        <a asp-action="Create" class="btn btn-admin-primary">
            <i class="bi bi-plus-lg"></i>
            افزودن محصول
        </a>
    }
</div>

<!-- Filters -->
<div class="admin-card mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small">جستجو</label>
            <input type="text" name="search" class="form-control"
                   placeholder="نام، SKU، بارکد..." value="@search" />
        </div>

        <div class="col-md-2">
            <label class="form-label small">دسته‌بندی</label>
            <select name="categoryId" class="form-select">
                <option value="">همه</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(categoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label small">برند</label>
            <select name="brandId" class="form-select">
                <option value="">همه</option>
                @foreach (var b in brands)
                {
                    <option value="@b.Id" selected="@(brandId == b.Id)">@b.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label small">خاستگاه</label>
            <select name="coffeeOriginId" class="form-select">
                <option value="">همه</option>
                @foreach (var o in origins)
                {
                    <option value="@o.Id" selected="@(coffeeOriginId == o.Id)">@o.Name</option>
                }
            </select>
        </div>

        <div class="col-md-1">
            <label class="form-label small">وضعیت</label>
            <select name="isActive" class="form-select">
                <option value="">همه</option>
                <option value="true" selected="@(isActive == true)">فعال</option>
                <option value="false" selected="@(isActive == false)">غیرفعال</option>
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-search"></i> فیلتر
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="admin-card p-0 overflow-hidden">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <div class="fs-1 text-muted mb-3"><i class="bi bi-inbox"></i></div>
            <h5 class="text-muted">محصولی یافت نشد</h5>
            @if (User.HasPermission(Permissions.Products.Create))
            {
                <a asp-action="Create" class="btn btn-admin-primary mt-2">
                    <i class="bi bi-plus-lg"></i> افزودن اولین محصول
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;">تصویر</th>
                        <th>نام / SKU</th>
                        <th>دسته / برند</th>
                        <th class="text-center">قیمت</th>
                        <th class="text-center">موجودی</th>
                        <th class="text-center">وضعیت</th>
                        <th class="text-center">آمار</th>
                        <th class="text-center" style="width: 160px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(p.PrimaryImageUrl))
                                {
                                    <img src="@p.PrimaryImageUrl" alt="@p.Name"
                                         style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;" />
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center"
                                         style="width: 50px; height: 50px; border-radius: 6px;">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold">@p.Name</div>
                                @if (!string.IsNullOrEmpty(p.Sku))
                                {
                                    <small class="text-muted">SKU: @p.Sku</small>
                                }
                                @if (p.HasVariants)
                                {
                                    <span class="badge bg-info text-dark ms-1">واریانت‌دار</span>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(p.CategoryName))
                                {
                                    <div><i class="bi bi-diagram-3"></i> @p.CategoryName</div>
                                }
                                @if (!string.IsNullOrEmpty(p.BrandName))
                                {
                                    <div class="text-muted"><i class="bi bi-award"></i> @p.BrandName</div>
                                }
                                @if (!string.IsNullOrEmpty(p.CoffeeOriginName))
                                {
                                    <div class="text-muted small"><i class="bi bi-geo-alt"></i> @p.CoffeeOriginName</div>
                                }
                            </td>
                            <td class="text-center">
                                @if (p.HasVariants && p.MinVariantPrice.HasValue)
                                {
                                    <div class="fw-bold">
                                        @p.MinVariantPrice.Value.ToString("N0")
                                        @if (p.MaxVariantPrice.HasValue && p.MaxVariantPrice != p.MinVariantPrice)
                                        {
                                            <span>— @p.MaxVariantPrice.Value.ToString("N0")</span>
                                        }
                                    </div>
                                    <small class="text-muted">تومان</small>
                                }
                                else if (p.BasePrice.HasValue)
                                {
                                    <div class="fw-bold">@p.BasePrice.Value.ToString("N0")</div>
                                    <small class="text-muted">تومان</small>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-@(p.TotalStock > 0 ? "success" : "danger")">
                                    @p.TotalStock
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex flex-column gap-1 align-items-center">
                                    @if (User.HasPermission(Permissions.Products.Edit))
                                    {
                                        <div class="form-check form-switch">
                                            <input class="form-check-input toggle-active" type="checkbox"
                                                   data-id="@p.Id" @(p.IsActive ? "checked" : "")
                                                   title="فعال/غیرفعال" />
                                        </div>
                                    }

                                    @if (User.HasPermission(Permissions.Products.Publish))
                                    {
                                        <button class="btn btn-sm @(p.IsPublished ? "btn-success" : "btn-outline-secondary") toggle-publish"
                                                data-id="@p.Id" title="@(p.IsPublished ? "منتشر شده" : "منتشر نشده")">
                                            <i class="bi @(p.IsPublished ? "bi-check-circle" : "bi-circle")"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                            <td class="text-center small">
                                <div><i class="bi bi-eye"></i> @p.ViewCount</div>
                                <div><i class="bi bi-cart"></i> @p.SoldCount</div>
                                <div><i class="bi bi-star-fill text-warning"></i> @p.AverageRating.ToString("0.0")</div>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Detail" asp-route-id="@p.Id"
                                       class="btn btn-outline-info" title="مشاهده">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.HasPermission(Permissions.Products.Edit))
                                    {
                                        <a asp-action="Edit" asp-route-id="@p.Id"
                                           class="btn btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (User.HasPermission(Permissions.Products.Delete))
                                    {
                                        <button type="button" class="btn btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                data-id="@p.Id" data-name="@p.Name" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="p-3 border-top">
                <nav>
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-search="@search">قبلی</a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == 1 || i == Model.TotalPages ||
                                (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageNumber="@i"
                                       asp-route-search="@search">@i</a>
                                </li>
                            }
                            else if (i == Model.PageNumber - 3 || i == Model.PageNumber + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        <li class="page-item @(Model.HasNext ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-search="@search">بعدی</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteId" />
                <div class="modal-header">
                    <h5 class="modal-title">تایید حذف</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    آیا از حذف محصول
                    <strong id="deleteName" class="text-danger"></strong>
                    مطمئن هستید؟
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-danger">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        // Toggle Active
        document.querySelectorAll('.toggle-active').forEach(el => {
            el.addEventListener('change', async function() {
                const id = this.dataset.id;
                try {
                    const r = await fetch('@Url.Action("ToggleActive")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                        body: `id=${id}&__RequestVerificationToken=${token}`
                    });
                    const data = await r.json();
                    if (!data.success) { alert(data.message); this.checked = !this.checked; }
                } catch { alert('خطا'); this.checked = !this.checked; }
            });
        });

        // Toggle Publish
        document.querySelectorAll('.toggle-publish').forEach(el => {
            el.addEventListener('click', async function() {
                const id = this.dataset.id;
                try {
                    const r = await fetch('@Url.Action("Publish")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                        body: `id=${id}&__RequestVerificationToken=${token}`
                    });
                    const data = await r.json();
                    if (data.success) {
                        this.classList.toggle('btn-success');
                        this.classList.toggle('btn-outline-secondary');
                        const icon = this.querySelector('i');
                        icon.className = data.isPublished ? 'bi bi-check-circle' : 'bi bi-circle';
                    } else {
                        alert(data.message);
                    }
                } catch { alert('خطا'); }
            });
        });

        // Delete Modal
        const deleteModal = document.getElementById('deleteModal');
        deleteModal?.addEventListener('show.bs.modal', function(e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteId').value = btn.dataset.id;
            document.getElementById('deleteName').textContent = btn.dataset.name;
        });
    </script>
}