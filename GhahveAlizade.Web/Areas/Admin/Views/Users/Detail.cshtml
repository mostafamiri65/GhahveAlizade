@model UserDetailDto
@using GhahveAlizade.Infrastructure.Persistence.Seed
@{
    ViewData["Title"] = $"کاربر: {Model.FullName ?? Model.UserName}";
    ViewData["PageIcon"] = "bi-person";
    var allRoles = ViewBag.AllRoles as List<string> ?? new();
}

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right"></i> بازگشت
    </a>
    @if (User.HasPermission(Permissions.Users.Edit))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-admin-primary">
            <i class="bi bi-pencil"></i> ویرایش
        </a>
    }
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="admin-card mb-3">
            <h5 class="mb-3">اطلاعات کاربر</h5>
            <div class="row g-2 small">
                <div class="col-md-6"><strong>نام کاربری:</strong> @Model.UserName</div>
                <div class="col-md-6"><strong>نام کامل:</strong> @(Model.FullName ?? "—")</div>
                <div class="col-md-6"><strong>ایمیل:</strong> @(Model.Email ?? "—")</div>
                <div class="col-md-6"><strong>موبایل:</strong> <span dir="ltr">@(Model.PhoneNumber ?? "—")</span></div>
                <div class="col-md-6"><strong>کد ملی:</strong> @(Model.NationalCode ?? "—")</div>
                <div class="col-md-6"><strong>جنسیت:</strong> @(Model.Gender ?? "—")</div>
                <div class="col-md-6"><strong>تاریخ تولد:</strong> @(Model.BirthDate?.ToString("yyyy/MM/dd") ?? "—")</div>
                <div class="col-md-6"><strong>تاریخ عضویت:</strong> @Model.CreatedAtUtc.ToString("yyyy/MM/dd")</div>
                <div class="col-md-6"><strong>آخرین ورود:</strong> @(Model.LastLoginAtUtc?.ToString("yyyy/MM/dd HH:mm") ?? "هرگز")</div>
                <div class="col-md-6"><strong>روش ورود:</strong> @(Model.LastLoginProvider ?? "—")</div>
            </div>
        </div>

        <!-- نقش‌ها -->
        @if (User.HasPermission(Permissions.Users.ManageRoles))
        {
            <div class="admin-card mb-3">
                <h6 class="mb-3"><i class="bi bi-shield-lock"></i> نقش‌ها</h6>
                <form id="rolesForm">
                    <div class="row g-2">
                        @foreach (var r in allRoles)
                        {
                            <div class="col-md-4 col-6">
                                <div class="form-check">
                                    <input type="checkbox" name="roles" value="@r"
                                           class="form-check-input" id="role_@r"
                                    @(Model.Roles.Contains(r) ? "checked" : "") />
                                    <label class="form-check-label" for="role_@r">@r</label>
                                </div>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-admin-primary mt-3" onclick="saveRoles()">
                        <i class="bi bi-check-lg"></i> ذخیره نقش‌ها
                    </button>
                </form>
            </div>
        }

        <!-- Reset Password -->
        @if (User.HasPermission(Permissions.Users.ResetPassword))
        {
            <div class="admin-card">
                <h6 class="mb-3"><i class="bi bi-key"></i> بازنشانی رمز عبور</h6>
                <div class="row g-2">
                    <div class="col-md-8">
                        <input type="password" id="newPassword" class="form-control"
                               placeholder="رمز عبور جدید (حداقل 8 کاراکتر)" />
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-warning w-100" onclick="resetPassword()">
                            <i class="bi bi-key"></i> تغییر رمز
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="admin-card mb-3">
            <div class="text-center">
                <div class="rounded-circle bg-warning mx-auto d-flex align-items-center justify-content-center"
                     style="width: 100px; height: 100px; color: white; font-size: 2.5rem; font-weight: bold;">
                    @(!string.IsNullOrEmpty(Model.FullName) ? Model.FullName[0].ToString() : Model.UserName[0].ToString())
                </div>
                <h5 class="mt-3">@(Model.FullName ?? Model.UserName)</h5>
            </div>
        </div>

        <div class="admin-card">
            <h6 class="mb-3">وضعیت</h6>
            <ul class="list-unstyled small mb-0">
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span>فعال:</span>
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                        @(Model.IsActive ? "بله" : "خیر")
                    </span>
                </li>
                <li class="d-flex justify-content-between py-2 border-bottom">
                    <span>موبایل تایید:</span>
                    <span class="badge @(Model.IsPhoneVerified ? "bg-success" : "bg-secondary")">
                        @(Model.IsPhoneVerified ? "بله" : "خیر")
                    </span>
                </li>
                <li class="d-flex justify-content-between py-2">
                    <span>پسورد دارد:</span>
                    <span class="badge @(Model.HasPassword ? "bg-success" : "bg-secondary")">
                        @(Model.HasPassword ? "بله" : "خیر")
                    </span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
            || document.querySelector('form#rolesForm input[name="__RequestVerificationToken"]')?.value;

        async function saveRoles() {
            const form = document.getElementById('rolesForm');
            const roles = Array.from(form.querySelectorAll('input[name="roles"]:checked'))
                .map(c => c.value);

            const body = new URLSearchParams();
            body.append('id', '@Model.Id');
            roles.forEach(r => body.append('roles', r));
            body.append('__RequestVerificationToken', token);

            const res = await fetch('@Url.Action("AssignRoles")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const d = await res.json();
            alert(d.message);
            if (d.success) location.reload();
        }

        async function resetPassword() {
            const pw = document.getElementById('newPassword').value;
            if (!pw || pw.length < 8) { alert('رمز باید حداقل 8 کاراکتر باشد.'); return; }
            if (!confirm('آیا از تغییر رمز عبور مطمئن هستید؟')) return;

            const body = new URLSearchParams();
            body.append('id', '@Model.Id');
            body.append('newPassword', pw);
            body.append('__RequestVerificationToken', token);

            const res = await fetch('@Url.Action("ResetPassword")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body
            });
            const d = await res.json();
            alert(d.message);
            if (d.success) document.getElementById('newPassword').value = '';
        }
    </script>
}