@model LoginViewModel
@{
    ViewData["Title"] = "ورود / ثبت‌نام";
}

<h2 class="text-xl font-bold text-gray-900 mb-2">ورود / ثبت‌نام</h2>
<p class="text-sm text-gray-600 mb-6">
    شماره موبایل خود را وارد کنید تا کد تایید برایتان ارسال شود.
</p>

<form asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

    <div>
        <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-1"></label>
        <input asp-for="PhoneNumber"
               type="tel"
               inputmode="numeric"
               autocomplete="tel"
               autofocus
               dir="ltr"
               class="w-full rounded-lg border border-gray-300 px-4 py-3 text-center text-lg tracking-widest focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-200"
               placeholder="09xxxxxxxxx" />
        <span asp-validation-for="PhoneNumber" class="text-xs text-red-600 mt-1 block"></span>
    </div>

    <button type="submit"
            class="w-full rounded-lg bg-amber-600 px-4 py-3 font-medium text-white hover:bg-amber-700 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2">
        دریافت کد تایید
    </button>

    <p class="text-center text-sm text-gray-600 pt-2">
        قبلاً ثبت‌نام کرده‌اید؟
        <a asp-action="LoginWithPassword" asp-route-returnUrl="@Model.ReturnUrl"
           class="text-amber-700 font-medium hover:underline">
            ورود با رمز عبور
        </a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}