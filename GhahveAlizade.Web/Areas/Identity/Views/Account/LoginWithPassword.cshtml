@model LoginWithPasswordViewModel
@{
    ViewData["Title"] = "ورود با رمز عبور";
}

<h2 class="text-xl font-bold text-gray-900 mb-2">ورود با رمز عبور</h2>
<p class="text-sm text-gray-600 mb-6">
    نام کاربری یا ایمیل خود را وارد کنید.
</p>

<form asp-action="LoginWithPassword" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

    <div>
        <label asp-for="UsernameOrEmail" class="block text-sm font-medium text-gray-700 mb-1"></label>
        <input asp-for="UsernameOrEmail" autocomplete="username" autofocus
               class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-200" />
        <span asp-validation-for="UsernameOrEmail" class="text-xs text-red-600 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1"></label>
        <input asp-for="Password" autocomplete="current-password"
               class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-200" />
        <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
    </div>

    <label class="flex items-center gap-2 text-sm text-gray-600">
        <input asp-for="RememberMe" type="checkbox" class="rounded border-gray-300 text-amber-600 focus:ring-amber-500" />
        @Html.DisplayNameFor(m => m.RememberMe)
    </label>

    <button type="submit"
            class="w-full rounded-lg bg-amber-600 px-4 py-3 font-medium text-white hover:bg-amber-700">
        ورود
    </button>

    <p class="text-center text-sm text-gray-600 pt-2">
        <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl"
           class="text-amber-700 font-medium hover:underline">
            ورود با پیامک
        </a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}