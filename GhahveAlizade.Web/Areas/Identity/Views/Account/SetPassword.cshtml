@model SetPasswordViewModel
@{
    ViewData["Title"] = "تعیین رمز عبور";
    var isPrompted = TempData["SetPasswordPrompt"] is bool;
}

@if (isPrompted)
{
    <div class="mb-4 rounded-lg bg-amber-50 border border-amber-200 p-3 text-sm text-amber-800">
        🎉 خوش آمدید! برای ورود سریع‌تر در آینده، می‌توانید اکنون رمز عبور تعیین کنید.
        این کار اختیاری است.
    </div>
}

<h2 class="text-xl font-bold text-gray-900 mb-2">تعیین رمز عبور</h2>
<p class="text-sm text-gray-600 mb-6">
    یک رمز عبور امن تعیین کنید تا در ورودهای بعدی نیازی به پیامک نداشته باشید.
</p>

<form asp-action="SetPassword" method="post" class="space-y-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

    <div>
        <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700 mb-1"></label>
        <input asp-for="NewPassword" autocomplete="new-password" autofocus
               class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-200" />
        <span asp-validation-for="NewPassword" class="text-xs text-red-600 mt-1 block"></span>
    </div>

    <div>
        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-1"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password"
               class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-amber-500 focus:outline-none focus:ring-2 focus:ring-amber-200" />
        <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600 mt-1 block"></span>
    </div>

    <button type="submit"
            class="w-full rounded-lg bg-amber-600 px-4 py-3 font-medium text-white hover:bg-amber-700">
        ثبت رمز عبور
    </button>

    @if (isPrompted)
    {
        <p class="text-center text-sm text-gray-500 pt-2">
            <a asp-controller="Home" asp-action="Index" asp-area=""
               class="hover:underline">
                فعلاً رد کن و ادامه بده
            </a>
        </p>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}