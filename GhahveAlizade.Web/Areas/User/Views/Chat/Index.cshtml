@{
	var sessionId = (long)ViewBag.SessionId;
	var sessionStatus = (Domain.Support.ChatSessionStatus)ViewBag.SessionStatus;
}

<h4 class="mb-4"><i class="bi bi-chat-dots"></i> گفتگوی آنلاین با پشتیبانی</h4>

<div class="user-card p-0" id="chatCard">
	<div class="p-3 border-bottom d-flex justify-content-between align-items-center">
		<span class="small text-muted">
			@if (sessionStatus == Domain.Support.ChatSessionStatus.Waiting)
			{
				<span><i class="bi bi-hourglass-split"></i> منتظر اپراتور... به‌زودی پاسخ می‌دهیم.</span>
			}
			else if (sessionStatus == Domain.Support.ChatSessionStatus.Active)
			{
				<span class="text-success"><i class="bi bi-circle-fill" style="font-size:8px"></i> گفتگو فعال</span>
			}
		</span>
		<form asp-action="Close" method="post" id="closeChatForm" style="display:none">
			<input type="hidden" name="sessionId" value="@sessionId" />
		</form>
		<button class="btn btn-outline-danger btn-sm" onclick="closeChat()">
			<i class="bi bi-x-circle"></i> پایان گفتگو
		</button>
	</div>

	<div class="p-3" id="chatMessages" style="height: 420px; overflow-y: auto;"></div>

	<div class="border-top p-3">
		<form id="chatForm" class="d-flex gap-2">
			<input type="text" id="chatInput" class="form-control" maxlength="2000"
				   placeholder="پیام خود را بنویسید..." autocomplete="off" />
			<button type="submit" class="btn btn-primary"><i class="bi bi-send"></i></button>
		</form>
	</div>
</div>

@section Scripts {
<style>
	.chat-bubble { max-width: 75%; padding: .6rem 1rem; border-radius: 1rem; margin-bottom: .5rem; }
	.chat-admin { background: #eef2ff; border: 1px solid #dbe4ff; align-self: flex-start; }
	.chat-user  { background: #fff3e0; border: 1px solid #ffe0b2; align-self: flex-end; }
	#chatMessages { display: flex; flex-direction: column; }
</style>
<script>
	const sessionId = @sessionId;
	let lastMessageId = 0;

	function escapeHtml(text) {
		const d = document.createElement('div');
		d.textContent = text;
		return d.innerHTML;
	}

	function renderMessage(m) {
		const cls = m.isFromAdmin ? 'chat-admin' : 'chat-user';
		const html = `
			<div class="chat-bubble ${cls}">
				<div class="d-flex justify-content-between mb-1">
					<strong class="small">${escapeHtml(m.senderName || '')}</strong>
					<small class="text-muted ms-2">${m.createdAt}</small>
				</div>
				<div style="white-space: pre-wrap;">${escapeHtml(m.body)}</div>
			</div>`;
		$('#chatMessages').append(html);
		lastMessageId = Math.max(lastMessageId, m.id);
		$('#chatMessages').scrollTop($('#chatMessages')[0].scrollHeight);
	}

	async function poll() {
		try {
			const res = await fetch(`/user/chat/history?sessionId=${sessionId}&afterMessageId=${lastMessageId}`);
			const data = await res.json();
			if (data.success && data.messages) {
				data.messages.forEach(renderMessage);
			}
		} catch (e) { /* silent */ }
	}

	$('#chatForm').on('submit', async function (e) {
		e.preventDefault();
		const body = $('#chatInput').val().trim();
		if (!body) return;
		$('#chatInput').val('');

		const token = $('input[name="__RequestVerificationToken"]').first().val();
		const res = await fetch('/user/chat/send', {
			method: 'POST',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: `sessionId=${sessionId}&body=${encodeURIComponent(body)}&__RequestVerificationToken=${encodeURIComponent(token)}`
		});
		const data = await res.json();
		if (data.success) renderMessage(data.message);
		else alert(data.message);
	});

	function closeChat() {
		if (!confirm('گفتگو بسته شود؟')) return;
		const token = $('input[name="__RequestVerificationToken"]').first().val();
		fetch('/user/chat/close', {
			method: 'POST',
			headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
			body: `sessionId=${sessionId}&__RequestVerificationToken=${encodeURIComponent(token)}`
		}).then(() => location.reload());
	}

	// بار اول: کل تاریخچه، بعد هر ۳ ثانیه polling
	poll().then(() => setInterval(poll, 3000));
</script>
}
