@using GhahveAlizade.Web.Areas.User.Controllers
@model ProfileViewModel

<h4 class="mb-4"><i class="bi bi-person-gear"></i> پروفایل من</h4>

<div class="user-card">
	<form asp-action="Update" method="post">
		<div class="row g-3">
			<div class="col-md-6">
				<label class="form-label">نام</label>
				<input asp-for="FirstName" class="form-control" />
			</div>
			<div class="col-md-6">
				<label class="form-label">نام خانوادگی</label>
				<input asp-for="LastName" class="form-control" />
			</div>
			<div class="col-md-6">
				<label class="form-label">ایمیل</label>
				<input asp-for="Email" type="email" class="form-control" dir="ltr" />
			</div>
			<div class="col-md-6">
				<label class="form-label">کد ملی</label>
				<input asp-for="NationalCode" class="form-control" dir="ltr" maxlength="10" />
			</div>
			<div class="col-md-4">
				<label class="form-label">تاریخ تولد</label>
				<input asp-for="BirthDate" type="date" class="form-control" />
			</div>
			<div class="col-md-4">
				<label class="form-label">جنسیت</label>
				<select asp-for="Gender" class="form-select">
					<option value="">انتخاب کنید</option>
					<option value="Male">مرد</option>
					<option value="Female">زن</option>
				</select>
			</div>
			<div class="col-md-4 d-flex align-items-end">
				<div class="form-check">
					<input asp-for="AcceptsMarketing" class="form-check-input" />
					<label asp-for="AcceptsMarketing" class="form-check-label">دریافت اخبار و تخفیف‌ها</label>
				</div>
			</div>
		</div>
		<div asp-validation-summary="All" class="text-danger mt-3"></div>
		<button type="submit" class="btn btn-primary mt-3">
			<i class="bi bi-check-lg"></i> ذخیره تغییرات
		</button>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
