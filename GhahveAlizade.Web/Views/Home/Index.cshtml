@{
    ViewData["Title"] = "قهوه علیزاده | تجربه‌ی یک فنجان بهتر";
}

<!-- ============ HERO ============ -->
<div class="coffee-hero">
    <div class="hero-inner">
        <span class="kicker rise-in">☕ رُست تازه · ارسال به سراسر ایران</span>
        <h1 class="rise-in">قهوه علیزاده</h1>
        <div class="hero-divider rise-in-1"></div>
        <p class="lead-text rise-in-1">
            دانه‌های تک‌خاستگاه و بلندهای خاص، تازه رُست‌شده در رستری اختصاصی ما —
            از مزرعه تا فنجان شما، بدون واسطه.
        </p>
        <div class="d-flex gap-3 justify-content-center flex-wrap rise-in-2">
            <a asp-controller="Products" asp-action="Index" class="btn btn-caramel btn-lg px-5">
                <i class="bi bi-bag-heart"></i> سفارش قهوه
            </a>
            <a asp-controller="Home" asp-action="About" class="btn btn-ghost-gold btn-lg px-4">
                داستان ما
            </a>
        </div>
        <div class="hero-stats rise-in-3">
            <div class="stat"><b>+۴۰</b><span>نوع دانه و بلند</span></div>
            <div class="stat"><b>۴۸h</b><span>از رُست تا ارسال</span></div>
            <div class="stat"><b>+۱۰,۰۰۰</b><span>فنجان خوشحال</span></div>
        </div>
    </div>
</div>

<!-- ============ FEATURES ============ -->
<div class="container py-5" dir="rtl">
    <div class="text-center mb-5">
        <span class="kicker">چرا علیزاده؟</span>
        <h2 class="section-title">قهوه‌ای که فرق دارد</h2>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-fire"></i></div>
                <h5 class="fw-bold">رُست تازه روزانه</h5>
                <p class="text-muted small mb-0 lh-lg">
                    دانه‌ها حداکثر ۴۸ ساعت پس از رُست، بسته‌بندی و ارسال می‌شوند تا عطر و طعم کامل حفظ شود.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-globe-americas"></i></div>
                <h5 class="fw-bold">دانه‌های تک‌خاستگاه</h5>
                <p class="text-muted small mb-0 lh-lg">
                    انتخاب مستقیم از مزارع اتیوپی، کلمبیا، برزیل و کنیا — بدون واسطه و با اصالت تضمین‌شده.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-truck"></i></div>
                <h5 class="fw-bold">ارسال سریع و ایمن</h5>
                <p class="text-muted small mb-0 lh-lg">
                    بسته‌بندی با پد حفظ عطر و ارسال به سراسر ایران در کوتاه‌ترین زمان.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- ============ CTA ============ -->
<div class="container pb-5">
    <div class="stat-band text-center">
        <h3 class="fw-bold mb-2">هر فنجان، یک تجربه‌ی تکرارنشدنی</h3>
        <p class="mb-4" style="color:var(--gold-soft)">همین حالا قهوه‌ی مورد علاقه‌تان را انتخاب کنید.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-caramel px-5">
            مشاهده فروشگاه <i class="bi bi-arrow-left"></i>
        </a>
    </div>
</div>