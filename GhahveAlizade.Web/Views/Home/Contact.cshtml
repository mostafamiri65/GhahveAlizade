@{
    ViewData["Title"] = "تماس با ما";
}

<div class="coffee-hero slim">
    <div class="hero-inner">
        <span class="kicker">💬 در تماس باشیم</span>
        <h1 class="rise-in" style="font-size:clamp(1.8rem,4vw,2.6rem)">همیشه پاسخگوی شما هستیم</h1>
        <p class="lead-text mb-0">سؤال، سفارش عمده یا همکاری؟ پیام بگذارید.</p>
    </div>
</div>

<div class="container py-5" dir="rtl">
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-6">
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-geo-alt"></i></div>
                <h6 class="fw-bold mb-1">آدرس</h6>
                <p class="text-muted small mb-0">تهران، خیابان ولیعصر، پلاک ۱۲۳</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-telephone"></i></div>
                <h6 class="fw-bold mb-1">تلفن</h6>
                <p class="text-muted small mb-0" dir="ltr">021-12345678</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-envelope"></i></div>
                <h6 class="fw-bold mb-1">ایمیل</h6>
                <p class="text-muted small mb-0" dir="ltr">info&#64;ghahvealizade.ir</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="feature-card">
                <div class="feature-icon"><i class="bi bi-clock"></i></div>
                <h6 class="fw-bold mb-1">ساعات کاری</h6>
                <p class="text-muted small mb-0">شنبه تا پنج‌شنبه · ۹ تا ۲۱</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="coffee-panel" style="overflow:hidden">
                <div class="panel-head"><i class="bi bi-chat-heart"></i> پیام بگذارید</div>
                <div class="p-4">
                    @* فرم تماس به‌زودی به Backend وصل می‌شود *@
                    <form method="post" asp-controller="Home" asp-action="Contact">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">نام و نام خانوادگی</label>
                                <input name="Name" class="form-control" required maxlength="100" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">ایمیل</label>
                                <input name="Email" type="email" class="form-control" required maxlength="150" dir="ltr" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">موضوع</label>
                                <input name="Subject" class="form-control" maxlength="150" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">پیام شما</label>
                                <textarea name="Message" class="form-control" rows="5" required maxlength="2000"></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-coffee px-4" disabled title="به‌زودی فعال می‌شود">
                                    <i class="bi bi-send"></i> ارسال پیام
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="coffee-panel h-100 p-4 d-flex flex-column justify-content-center text-center">
                <h6 class="fw-bold mb-3"><i class="bi bi-share"></i> ما را دنبال کنید</h6>
                <div class="d-flex justify-content-center gap-3 mb-4">
                    <a href="#" class="feature-icon" style="width:52px;height:52px;font-size:1.3rem;text-decoration:none"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="feature-icon" style="width:52px;height:52px;font-size:1.3rem;text-decoration:none"><i class="bi bi-telegram"></i></a>
                    <a href="#" class="feature-icon" style="width:52px;height:52px;font-size:1.3rem;text-decoration:none"><i class="bi bi-whatsapp"></i></a>
                </div>
                <div class="quote-block small">
                    «قهوه‌ی خوب، دلیلی برای یک گفتگوی خوب است.»
                </div>
            </div>
        </div>
    </div>
</div>