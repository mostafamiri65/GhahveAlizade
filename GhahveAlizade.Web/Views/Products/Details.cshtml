@using GhahveAlizade.Application.Features.Catalog.Products.Dtos
@model ProductDetailDto
@{
    var primaryImage = Model.Images.FirstOrDefault(i => i.IsPrimary)?.ImageUrl
                       ?? Model.Images.FirstOrDefault()?.ImageUrl;
}

<div class="container py-4" dir="rtl">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">خانه</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">فروشگاه</a></li>
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <li class="breadcrumb-item"><span class="text-muted">@Model.CategoryName</span></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-lg-6">
            <div class="product-detail-img">
                @if (!string.IsNullOrEmpty(primaryImage))
                {
                    <img src="@primaryImage" alt="@(Model.Images.FirstOrDefault(i => i.IsPrimary)?.AltText ?? Model.Name)" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <i class="bi bi-cup-hot fs-1" style="color:var(--coffee-caramel)"></i>
                    </div>
                }
            </div>
            @if (Model.Images.Count > 1)
            {
                <div class="d-flex gap-2 mt-3 overflow-auto">
                    @foreach (var img in Model.Images)
                    {
                        <div style="width:80px;height:80px;border-radius:.6rem;overflow:hidden;flex:0 0 auto;background:var(--coffee-latte)">
                            @if (!string.IsNullOrEmpty(img.ThumbnailUrl ?? img.ImageUrl))
                            {
                                <img src="@(img.ThumbnailUrl ?? img.ImageUrl)" alt="@img.AltText" style="width:100%;height:100%;object-fit:cover" />
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-6">
            @if (!string.IsNullOrEmpty(Model.BrandName))
            {
                <div class="text-muted small mb-1"><i class="bi bi-award"></i> برند: @Model.BrandName</div>
            }
            <h1 class="fw-bold" style="color:var(--coffee-espresso)">@Model.Name</h1>

            @if (Model.AverageRating > 0)
            {
                <div class="rating-stars mb-2">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= Math.Round(Model.AverageRating) ? "bi-star-fill" : "bi-star")"></i>
                    }
                    <span class="text-muted small ms-1">(@Model.ReviewCount نظر)</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ShortDescription))
            {
                <p class="coffee-content">@Model.ShortDescription</p>
            }

            @* ویژگی‌های قهوه *@
            <div class="d-flex flex-wrap gap-2 my-3">
                @if (!string.IsNullOrEmpty(Model.CoffeeOriginName))
                {
                    <span class="badge badge-outline-coffee"><i class="bi bi-geo-alt"></i> خاستگاه: @Model.CoffeeOriginName</span>
                }
                @if (!string.IsNullOrEmpty(Model.RoastProfileName))
                {
                    <span class="badge badge-outline-coffee"><i class="bi bi-fire"></i> رُست: @Model.RoastProfileName</span>
                }
                @if (!string.IsNullOrEmpty(Model.CoffeeProcessName))
                {
                    <span class="badge badge-outline-coffee"><i class="bi bi-droplet"></i> پروسس: @Model.CoffeeProcessName</span>
                }
                @foreach (var note in Model.FlavorNoteNames)
                {
                    <span class="badge badge-coffee">@note</span>
                }
            </div>

            @* قیمت و واریانت‌ها *@
            <div class="coffee-panel p-4 my-3">
                @if (Model.HasVariants && Model.Variants.Count > 0)
                {
                    <h6 class="fw-bold mb-3">انتخاب بسته‌بندی:</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var v in Model.Variants)
                        {
                            <div class="border rounded-3 px-3 py-2 @(v.IsDefault ? "border-2" : "")" style="border-color:var(--coffee-caramel)">
                                <div class="fw-semibold small">@v.Name</div>
                                <div class="product-price small">@v.Price.ToString("N0") تومان</div>
                            </div>
                        }
                    </div>
                }
                else if (Model.BasePrice.HasValue)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="product-price fs-4">@Model.BasePrice.Value.ToString("N0") تومان</span>
                        @if (Model.CompareAtPrice.HasValue && Model.CompareAtPrice > Model.BasePrice)
                        {
                            <span class="product-price-old fs-6">@Model.CompareAtPrice.Value.ToString("N0")</span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">برای استعلام قیمت تماس بگیرید.</span>
                }

                <button class="btn btn-coffee w-100 mt-4" disabled
                        title="افزودن به سبد خرید به‌زودی فعال می‌شود">
                    <i class="bi bi-cart-plus"></i> افزودن به سبد خرید
                </button>
                <div class="text-muted small text-center mt-2">
                    <i class="bi bi-info-circle"></i> ثبت سفارش به‌زودی فعال می‌شود.
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <h5 class="section-title mt-4 mb-3">درباره این قهوه</h5>
                <div class="coffee-content">@Html.Raw(Model.Description)</div>
            }

            @if (Model.Attributes.Count > 0)
            {
                <h5 class="section-title mt-4 mb-3">مشخصات</h5>
                <table class="table table-sm coffee-panel">
                    <tbody>
                        @foreach (var a in Model.Attributes)
                        {
                            <tr>
                                <td class="fw-semibold" style="width:35%">@a.AttributeName@(string.IsNullOrEmpty(a.Unit) ? "" : $" ({a.Unit})")</td>
                                <td>@(a.Value ?? a.CustomValue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>