<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - قهوه علیزاده</title>

    <meta name="robots" content="noindex, nofollow" />

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" />

    <style>
            body { font-family: 'Vazirmatn', sans-serif; }
    </style>

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="min-h-screen bg-gradient-to-br from-amber-50 to-orange-100 flex items-center justify-center p-4">

    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <a href="/" class="inline-block">
                <h1 class="text-3xl font-bold text-amber-900">☕ قهوه علیزاده</h1>
            </a>
            <p class="text-sm text-amber-700 mt-2">فروشگاه تخصصی قهوه</p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8">
            @if (TempData["SuccessMessage"] is string successMsg)
            {
                <div class="mb-4 rounded-lg bg-green-50 border border-green-200 p-3 text-sm text-green-800">
                    ✓ @successMsg
                </div>
            }

            @if (TempData["ErrorMessage"] is string errorMsg)
            {
                <div class="mb-4 rounded-lg bg-red-50 border border-red-200 p-3 text-sm text-red-800">
                    ✗ @errorMsg
                </div>
            }

            @RenderBody()
        </div>

        <p class="text-center text-xs text-amber-700 mt-6">
            © @DateTime.Now.Year - تمامی حقوق محفوظ است.
        </p>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>