@using Microsoft.Extensions.Options
@using GhahveAlizade.Infrastructure.Seo
@inject IOptions<SeoOptions> SeoOptions

@{
    var options = SeoOptions.Value;
    var env = Context.RequestServices.GetService<IWebHostEnvironment>();
    var isProd = env?.IsProduction() ?? false;
}

@if (isProd && !string.IsNullOrEmpty(options.GoogleTagManagerId))
{
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', '@options.GoogleTagManagerId');
    </script>
}

@if (isProd && !string.IsNullOrEmpty(options.GoogleAnalyticsId))
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=@options.GoogleAnalyticsId"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', '@options.GoogleAnalyticsId');
    </script>
}