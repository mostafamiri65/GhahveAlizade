@{
    var currentYear = DateTime.Now.Year;
}

<footer class="site-footer mt-5 pt-5 pb-3 bg-dark text-light">
    <div class="container">
        <div class="row g-4">
            <!-- درباره -->
            <div class="col-lg-4 col-md-6">
                <h5 class="text-warning mb-3">
                    <i class="bi bi-cup-hot-fill"></i> قهوه علیزاده
                </h5>
                <p class="text-muted small lh-lg">
                    فروشگاه تخصصی قهوه علیزاده - ارائه‌دهنده قهوه‌های تازه رست شده،
                    دانه‌های خاص و تجهیزات حرفه‌ای دم‌آوری.
                </p>
                <div class="d-flex gap-3 mt-3">
                    <a href="#" class="text-light" title="اینستاگرام">
                        <i class="bi bi-instagram fs-5"></i>
                    </a>
                    <a href="#" class="text-light" title="تلگرام">
                        <i class="bi bi-telegram fs-5"></i>
                    </a>
                    <a href="#" class="text-light" title="واتساپ">
                        <i class="bi bi-whatsapp fs-5"></i>
                    </a>
                    <a href="#" class="text-light" title="لینکدین">
                        <i class="bi bi-linkedin fs-5"></i>
                    </a>
                </div>
            </div>

            <!-- دسترسی سریع -->
            <div class="col-lg-2 col-md-6">
                <h6 class="text-warning mb-3">دسترسی سریع</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none">
                            صفحه اصلی
                        </a>
                    </li>
                    <li class="mb-2">
                        <a asp-controller="Products" asp-action="Index" class="text-muted text-decoration-none">
                            فروشگاه
                        </a>
                    </li>
                    <li class="mb-2">
                        <a asp-controller="Blog" asp-action="Index" class="text-muted text-decoration-none">
                            وبلاگ
                        </a>
                    </li>
                    <li class="mb-2">
                        <a asp-controller="Home" asp-action="About" class="text-muted text-decoration-none">
                            درباره ما
                        </a>
                    </li>
                    <li class="mb-2">
                        <a asp-controller="Home" asp-action="Contact" class="text-muted text-decoration-none">
                            تماس با ما
                        </a>
                    </li>
                </ul>
            </div>

            <!-- خدمات مشتریان -->
            <div class="col-lg-2 col-md-6">
                <h6 class="text-warning mb-3">خدمات مشتریان</h6>
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <a href="#" class="text-muted text-decoration-none">پیگیری سفارش</a>
                    </li>
                    <li class="mb-2">
                        <a href="#" class="text-muted text-decoration-none">رویه ارسال</a>
                    </li>
                    <li class="mb-2">
                        <a href="#" class="text-muted text-decoration-none">شرایط بازگشت</a>
                    </li>
                    <li class="mb-2">
                        <a href="#" class="text-muted text-decoration-none">سوالات متداول</a>
                    </li>
                    <li class="mb-2">
                        <a href="#" class="text-muted text-decoration-none">حریم خصوصی</a>
                    </li>
                </ul>
            </div>

            <!-- تماس -->
            <div class="col-lg-4 col-md-6">
                <h6 class="text-warning mb-3">تماس با ما</h6>
                <ul class="list-unstyled small text-muted">
                    <li class="mb-2">
                        <i class="bi bi-geo-alt"></i>
                        تهران، خیابان ولیعصر
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-telephone"></i>
                        <a href="tel:+982112345678" class="text-muted text-decoration-none" dir="ltr">
                            021-12345678
                        </a>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-envelope"></i>
                        <a href="mailto:info@ghahvealizade.ir" class="text-muted text-decoration-none">
                            info@ghahvealizade.ir
                        </a>
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-clock"></i>
                        شنبه تا پنج‌شنبه، ۹ صبح تا ۹ شب
                    </li>
                </ul>

                <!-- نمادها -->
                <div class="d-flex gap-2 mt-3">
                    <a href="#" class="bg-white p-1 rounded" title="نماد اعتماد الکترونیکی">
                        <div style="width: 60px; height: 60px; background: #f3f4f6; border-radius: 4px;"></div>
                    </a>
                    <a href="#" class="bg-white p-1 rounded" title="ساماندهی">
                        <div style="width: 60px; height: 60px; background: #f3f4f6; border-radius: 4px;"></div>
                    </a>
                </div>
            </div>
        </div>

        <hr class="border-secondary my-4" />

        <!-- Copyright -->
        <div class="row">
            <div class="col-md-6 text-center text-md-start small text-muted">
                © @currentYear - تمامی حقوق برای <strong class="text-warning">قهوه علیزاده</strong> محفوظ است.
            </div>
            <div class="col-md-6 text-center text-md-end small text-muted">
                طراحی و توسعه با <i class="bi bi-heart-fill text-danger"></i>
            </div>
        </div>
    </div>
</footer>

<style>
    .site-footer a:hover {
        color: var(--color-accent) !important;
    }
</style>