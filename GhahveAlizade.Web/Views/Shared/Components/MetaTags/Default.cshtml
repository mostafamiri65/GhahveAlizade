@model GhahveAlizade.Application.Common.Models.SeoData
@{
    var options = ViewData["SeoOptions"] as GhahveAlizade.Infrastructure.Seo.SeoOptions;
    var siteName = options?.SiteName ?? "قهوه علیزاده";
    var baseUrl = options?.SiteBaseUrl?.TrimEnd('/') ?? "";
    var twitterHandle = options?.TwitterHandle;
    var defaultOgImage = options?.DefaultOgImage ?? "/images/og-default.jpg";
    var fullTitle = Model.Title?.Contains(siteName) == true
        ? Model.Title
        : $"{Model.Title} | {siteName}";
    var ogImage = Model.OgImage ?? defaultOgImage;
    if (!ogImage.StartsWith("http")) ogImage = $"{baseUrl}{ogImage}";
}

<!-- Title -->
<title>@fullTitle</title>

<!-- Basic Meta -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
<meta name="theme-color" content="#78350f" />

@if (!string.IsNullOrEmpty(Model.Description))
{
    <meta name="description" content="@Model.Description" />
}
@if (!string.IsNullOrEmpty(Model.Keywords))
{
    <meta name="keywords" content="@Model.Keywords" />
}

<!-- Robots -->
@if (Model.NoIndex || Model.NoFollow)
{
    var content = $"{(Model.NoIndex ? "noindex" : "index")},{(Model.NoFollow ? "nofollow" : "follow")}";
    <meta name="robots" content="@content" />
}
else
{
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
}

<!-- Canonical -->
<link rel="canonical" href="@Model.CanonicalUrl" />

<!-- Open Graph -->
<meta property="og:type" content="@Model.OgType" />
<meta property="og:title" content="@fullTitle" />
@if (!string.IsNullOrEmpty(Model.Description))
{
    <meta property="og:description" content="@Model.Description" />
}
<meta property="og:url" content="@Model.CanonicalUrl" />
<meta property="og:image" content="@ogImage" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="@siteName" />
<meta property="og:locale" content="fa_IR" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="@fullTitle" />
@if (!string.IsNullOrEmpty(Model.Description))
{
    <meta name="twitter:description" content="@Model.Description" />
}
<meta name="twitter:image" content="@ogImage" />
@if (!string.IsNullOrEmpty(twitterHandle))
{
    <meta name="twitter:site" content="@twitterHandle" />
}

<!-- Google Verification -->
@if (!string.IsNullOrEmpty(options?.GoogleSiteVerification))
{
    <meta name="google-site-verification" content="@options.GoogleSiteVerification" />
}

<!-- Preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- JSON-LD -->
@if (!string.IsNullOrEmpty(Model.JsonLd))
{
    <script type="application/ld+json">
        @Html.Raw(Model.JsonLd)
    </script>
}