@model ErrorViewModel
@{
    ViewData["Title"] = (string?)ViewData["ErrorTitle"] ?? "خطا";
    var errorTitle = (string?)ViewData["ErrorTitle"];
}

<div class="container py-5 text-center" dir="rtl" style="min-height:60vh">
    <i class="bi bi-cup-hot display-1" style="color:var(--coffee-gold)"></i>
    <h1 class="fw-bold mt-3" style="color:var(--coffee-espresso)">اوه! قهوه‌مان ریخت...</h1>

    @if (!string.IsNullOrEmpty(errorTitle))
    {
        <p class="lead text-muted mb-4">@errorTitle</p>
    }
    else
    {
        <p class="lead text-muted mb-4">در پردازش درخواست شما خطایی رخ داد. لطفاً دوباره تلاش کنید.</p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-coffee px-4">
        <i class="bi bi-house"></i> بازگشت به خانه
    </a>
</div>